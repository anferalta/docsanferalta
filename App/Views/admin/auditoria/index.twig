{% extends "@admin/layout.twig" %}
{% block title %}Auditoria{% endblock %}
{% block content %}
{% set query = filtros|merge({'ordem':ordem,'dir':dir}) %}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <h3>Auditoria</h3>
    <div><a href="/admin/auditoria/dashboard?{{ query|url_encode }}" class="btn btn-outline-primary">Dashboard</a>
        <a href="/admin/auditoria/exportar?{{ query|url_encode }}" class="btn btn-success">Exportar CSV</a></div>
</div>
{% include '@admin/auditoria/_filtros.twig' with {'destino':'/admin/auditoria'} %}
<p class="text-muted">{{ total }} registo(s) encontrado(s). Página {{ pagina }} de {{ paginas }}.</p>
<label for="pesquisaRapida" class="form-label">Pesquisar nesta página</label>
<input type="search" id="pesquisaRapida" class="form-control mb-3" placeholder="Filtrar os registos já apresentados">
<div class="table-responsive">
<table class="table table-striped align-middle" id="tabela_auditoria">
    <thead><tr>
        {% for coluna, rotulo in {'id':'ID','utilizador_nome':'Utilizador','acao':'Ação','ip':'IP','criado_em':'Data','origem':'Origem'} %}
        <th scope="col"><a href="?{{ query|merge({'ordem':coluna,'dir':ordem == coluna and dir == 'ASC' ? 'DESC' : 'ASC','p':1})|url_encode }}">{{ rotulo }}{{ ordem == coluna ? (dir == 'ASC' ? ' ↑' : ' ↓') : '' }}</a></th>
        {% endfor %}
        <th scope="col">Detalhes</th>
    </tr></thead>
    <tbody>
    {% for log in logs %}
        <tr data-registo>
            <td>{{ log.id }}</td><td>{{ log.utilizador_nome ?: 'N/A' }}</td>
            <td>{% set acao = log.acao ? log.acao|lower : '' %}
                {% if 'criou' in acao %}<span class="badge bg-success">{{ log.acao }}</span>
                {% elseif 'editou' in acao %}<span class="badge bg-warning text-dark">{{ log.acao }}</span>
                {% elseif 'apagou' in acao or 'eliminou' in acao %}<span class="badge bg-danger">{{ log.acao }}</span>
                {% else %}{{ log.acao ?: 'N/A' }}{% endif %}
            </td>
            <td>{{ log.ip ?: '—' }}</td><td class="text-nowrap">{{ log.criado_em ?: '—' }}</td>
            <td><span class="badge {{ log.origem == 'auditoria' ? 'bg-primary' : 'bg-danger' }}">{{ log.origem == 'auditoria' ? 'Geral' : 'Eliminação' }}</span></td>
            <td><a href="/admin/auditoria/{{ log.id }}?origem={{ log.origem|url_encode }}" class="btn btn-sm btn-secondary">Detalhes</a></td>
        </tr>
    {% else %}
        <tr><td colspan="7" class="text-center text-muted">Nenhum registo encontrado para os filtros selecionados.</td></tr>
    {% endfor %}
    <tr id="pesquisa_sem_resultados" hidden><td colspan="7" class="text-center text-muted">Nenhum resultado nesta página.</td></tr>
    </tbody>
</table>
</div>
{% if paginas > 1 %}
<nav aria-label="Páginas da auditoria"><ul class="pagination flex-wrap">
    <li class="page-item {{ pagina == 1 ? 'disabled' : '' }}">
        {% if pagina > 1 %}<a class="page-link" href="?{{ query|merge({'p':pagina-1})|url_encode }}">Anterior</a>{% else %}<span class="page-link">Anterior</span>{% endif %}
    </li>
    {% set inicio = max(1, pagina-2) %}{% set fim = min(paginas, pagina+2) %}
    {% if inicio > 1 %}<li class="page-item"><a class="page-link" href="?{{ query|merge({'p':1})|url_encode }}">1</a></li>{% endif %}
    {% if inicio > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
    {% for p in inicio..fim %}
        <li class="page-item {{ p == pagina ? 'active' : '' }}"><a class="page-link" {% if p == pagina %}aria-current="page"{% endif %} href="?{{ query|merge({'p':p})|url_encode }}">{{ p }}</a></li>
    {% endfor %}
    {% if fim < paginas-1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
    {% if fim < paginas %}<li class="page-item"><a class="page-link" href="?{{ query|merge({'p':paginas})|url_encode }}">{{ paginas }}</a></li>{% endif %}
    <li class="page-item {{ pagina == paginas ? 'disabled' : '' }}">
        {% if pagina < paginas %}<a class="page-link" href="?{{ query|merge({'p':pagina+1})|url_encode }}">Seguinte</a>{% else %}<span class="page-link">Seguinte</span>{% endif %}
    </li>
</ul></nav>
{% endif %}
{% endblock %}
{% block scripts %}
<script>
(() => {
    const input = document.getElementById('pesquisaRapida');
    const rows = document.querySelectorAll('#tabela_auditoria [data-registo]');
    input.addEventListener('input', () => {
        const query = input.value.trim().toLocaleLowerCase('pt');
        let visiveis = 0;
        rows.forEach(row => { row.hidden = !row.textContent.toLocaleLowerCase('pt').includes(query); if (!row.hidden) visiveis++; });
        document.getElementById('pesquisa_sem_resultados').hidden = rows.length === 0 || visiveis > 0;
    });
})();
</script>
{% endblock %}
