{% extends "@admin/layout.twig" %}
{% block title %}Detalhes da Auditoria{% endblock %}
{% block content %}
<h3 class="mb-4">Detalhes da Auditoria</h3>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">ID do registo</dt><dd class="col-sm-9">{{ log.id }}</dd>
        <dt class="col-sm-3">Origem</dt><dd class="col-sm-9">{{ log.origem == 'auditoria' ? 'Geral' : 'Eliminação' }}</dd>
        <dt class="col-sm-3">Utilizador</dt><dd class="col-sm-9">{{ log.utilizador_nome ?: 'N/A' }}</dd>
        <dt class="col-sm-3">Ação</dt><dd class="col-sm-9">{{ log.acao ?: 'N/A' }}</dd>
        <dt class="col-sm-3">IP</dt><dd class="col-sm-9">{{ log.ip ?: '—' }}</dd>
        <dt class="col-sm-3">Data</dt><dd class="col-sm-9">{{ log.criado_em ?: '—' }}</dd>
    </dl>
    <h5>Detalhes</h5><pre class="p-3 bg-light border rounded" style="white-space:pre-wrap;overflow-wrap:anywhere">{{ log.detalhes ?: 'Sem detalhes adicionais.' }}</pre>
    <a href="/admin/auditoria" class="btn btn-secondary">Voltar</a>
</div></div>
{% endblock %}
