{% extends "@admin/layout.twig" %}

{% block content %}

<div class="container-fluid">

    <h4 class="mb-3">
        <i class="fa fa-file-export me-2"></i> Relatórios SLA
    </h4>

    <!-- FILTROS -->
    <div class="card mb-3">
        <div class="card-body">

            <form method="get" class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Área</label>
                    <select name="area" class="form-select">
                        <option value="">Todas</option>
                        {% for a in areas %}
                            <option value="{{ a }}" {{ a == app.request.get('area') ? 'selected' : '' }}>
                                {{ a }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">Todos</option>
                        {% for e in estados %}
                            <option value="{{ e }}" {{ e == app.request.get('estado') ? 'selected' : '' }}>
                                {{ e|capitalize }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Data Inicial</label>
                    <input type="date" name="data_inicio" class="form-control"
                           value="{{ app.request.get('data_inicio') }}">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Data Final</label>
                    <input type="date" name="data_fim" class="form-control"
                           value="{{ app.request.get('data_fim') }}">
                </div>

                <div class="col-md-12 text-end">
                    <button class="btn btn-primary">
                        <i class="fa fa-filter me-1"></i> Filtrar
                    </button>

                    <a href="/admin/relatorios" class="btn btn-secondary">Limpar</a>

                    <a href="/admin/relatorios/exportar/pdf?{{ app.request.queryString }}" class="btn btn-danger">
                        <i class="fa fa-file-pdf me-1"></i> PDF
                    </a>

                    <a href="/admin/relatorios/exportar/excel?{{ app.request.queryString }}" class="btn btn-success">
                        <i class="fa fa-file-excel me-1"></i> Excel
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- RESUMO SLA -->
    <div class="card mb-3">
        <div class="card-body">

            <h6 class="mb-3">Resumo SLA</h6>

            <div class="row text-center">

                <div class="col-md-4">
                    <span class="badge bg-success" style="font-size: 16px;">
                        OK: {{ totais.ok }}
                    </span>
                </div>

                <div class="col-md-4">
                    <span class="badge bg-warning text-dark" style="font-size: 16px;">
                        Alerta: {{ totais.alerta }}
                    </span>
                </div>

                <div class="col-md-4">
                    <span class="badge bg-danger" style="font-size: 16px;">
                        Atrasado: {{ totais.atrasado }}
                    </span>
                </div>

            </div>

        </div>
    </div>

    <!-- TABELA -->
    <div class="card">
        <div class="card-body">

            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th>SLA</th>
                        <th>Dias Parado</th>
                        <th>Criado em</th>
                    </tr>
                </thead>

                <tbody>
                    {% for d in documentos %}
                        <tr>
                            <td>{{ d.id }}</td>
                            <td>{{ d.titulo }}</td>
                            <td>{{ d.area_nome }}</td>
                            <td>{{ d.estado_atual }}</td>

                            <td>
                                {% if d.sla == 'ok' %}
                                    <span class="badge bg-success">OK</span>
                                {% elseif d.sla == 'alerta' %}
                                    <span class="badge bg-warning text-dark">Alerta</span>
                                {% elseif d.sla == 'atrasado' %}
                                    <span class="badge bg-danger">Atrasado</span>
                                {% else %}
                                    <span class="badge bg-secondary">—</span>
                                {% endif %}
                            </td>

                            <td>{{ d.dias_parado ?? '—' }}</td>
                            <td>{{ d.criado_em|date("d/m/Y") }}</td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>

        </div>
    </div>

</div>

{% endblock %}
