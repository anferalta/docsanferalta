{% extends "@admin/layout.twig" %}
{% block title %}Agendamento: {{ nome }}{% endblock %}
{% block page_title %}Detalhes do Agendamento{% endblock %}

{% block content %}

<div class="card">
    <div class="card-body">

        <h5 class="mb-3">{{ dados.nome }}</h5>

        <p><strong>Frequência:</strong> <code>{{ dados.frequencia }}</code></p>

        <p><strong>Estado:</strong>
            {% if dados.ativo %}
                <span class="badge bg-success px-3 py-2">Ativo</span>
            {% else %}
                <span class="badge bg-secondary px-3 py-2">Inativo</span>
            {% endif %}
        </p>

        <p><strong>Última Execução:</strong> {{ dados.ultima_execucao ?? '—' }}</p>
        <p><strong>Próxima Execução:</strong> {{ dados.proxima_execucao ?? '—' }}</p>

        <hr>

        <div class="d-flex gap-2">

            <a href="/admin/agendamentos/editar/{{ nome }}" class="btn btn-outline-warning">
                Editar
            </a>

            {% if dados.ativo %}
                <form action="/admin/agendamentos/desativar/{{ nome }}" method="post" class="d-inline">
                    {{ csrf_field() }}
                    <button class="btn btn-outline-secondary">Desativar</button>
                </form>
            {% else %}
                <form action="/admin/agendamentos/ativar/{{ nome }}" method="post" class="d-inline">
                    {{ csrf_field() }}
                    <button class="btn btn-outline-success">Ativar</button>
                </form>
            {% endif %}

            <form action="/admin/agendamentos/eliminar/{{ nome }}" method="post" class="d-inline">
                {{ csrf_field() }}
                <button class="btn btn-outline-danger"
                        onclick="return confirm('Eliminar este agendamento?');">
                    Eliminar
                </button>
            </form>

            <a href="/admin/agendamentos" class="btn btn-light">Voltar</a>

        </div>

    </div>
</div>

{% endblock %}
