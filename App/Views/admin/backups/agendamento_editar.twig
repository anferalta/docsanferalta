{% extends "@admin/layout.twig" %}
{% block title %}Editar Agendamento{% endblock %}
{% block page_title %}Editar Agendamento{% endblock %}

{% block content %}

<div class="card">
    <div class="card-body">

        <form method="post">
            {{ csrf_field() }}

            <!-- Nome da tarefa (não editável) -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Nome</label>
                <input type="text" class="form-control" value="{{ dados.nome }}" disabled>
                <small class="text-muted">O nome da tarefa não pode ser alterado.</small>
            </div>

            <!-- Frequência cron -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Frequência (cron)</label>
                <input type="text" name="frequencia" class="form-control" value="{{ dados.frequencia }}" required>

                <small class="text-muted d-block mt-1">
                    Exemplos:
                    <ul class="mt-1 mb-0">
                        <li><code>0 3 * * *</code> — todos os dias às 03:00</li>
                        <li><code>0 4 * * 0</code> — todos os domingos às 04:00</li>
                        <li><code>30 2 * * *</code> — todos os dias às 02:30</li>
                    </ul>
                </small>
            </div>

            <!-- Estado -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Ativo</label>
                <div class="form-check">
                    <input type="checkbox" name="ativo" class="form-check-input" id="ativoCheck"
                           {% if dados.ativo %}checked{% endif %}>
                    <label class="form-check-label" for="ativoCheck">Agendamento ativo</label>
                </div>
            </div>

            <!-- Última execução (informativo) -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Última Execução</label>
                <input type="text" class="form-control" value="{{ dados.ultima_execucao ?? '—' }}" disabled>
            </div>

            <!-- Próxima execução (informativo) -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Próxima Execução</label>
                <input type="text" class="form-control" value="{{ dados.proxima_execucao ?? '—' }}" disabled>
            </div>

            <button class="btn btn-primary">Guardar</button>
            <a href="/admin/agendamentos" class="btn btn-light">Cancelar</a>

        </form>

    </div>
</div>

{% endblock %}
