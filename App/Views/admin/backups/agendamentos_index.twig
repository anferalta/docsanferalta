{% extends "@admin/layout.twig" %}
{% block title %}Agendamentos{% endblock %}
{% block page_title %}Gestão de Agendamentos{% endblock %}

{% block content %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Agendamentos configurados</h5>
    <a href="/admin/agendamentos/criar" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Criar novo agendamento
    </a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Nome</th>
            <th>Frequência</th>
            <th>Estado</th>
            <th>Última Execução</th>
            <th>Próxima Execução</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>

    <tbody>
        {% for nome, dados in cron %}
            <tr>
                <td class="fw-semibold">{{ dados.nome }}</td>
                <td><code>{{ dados.frequencia }}</code></td>

                <td>
                    {% if dados.ativo %}
                        <span class="badge bg-success px-3 py-2">Ativo</span>
                    {% else %}
                        <span class="badge bg-secondary px-3 py-2">Inativo</span>
                    {% endif %}
                </td>

                <td>{{ dados.ultima_execucao ?? '—' }}</td>
                <td>{{ dados.proxima_execucao ?? '—' }}</td>

                <td class="text-end">

                    <a href="/admin/agendamentos/ver/{{ nome }}" class="btn btn-sm btn-outline-primary">
                        Ver
                    </a>

                    <a href="/admin/agendamentos/editar/{{ nome }}" class="btn btn-sm btn-outline-warning">
                        Editar
                    </a>

                    {% if dados.ativo %}
                        <form action="/admin/agendamentos/desativar/{{ nome }}" method="post" class="d-inline">
                            {{ csrf_field() }}
                            <button class="btn btn-sm btn-outline-secondary">
                                Desativar
                            </button>
                        </form>
                    {% else %}
                        <form action="/admin/agendamentos/ativar/{{ nome }}" method="post" class="d-inline">
                            {{ csrf_field() }}
                            <button class="btn btn-sm btn-outline-success">
                                Ativar
                            </button>
                        </form>
                    {% endif %}

                    <form action="/admin/agendamentos/eliminar/{{ nome }}" method="post" class="d-inline">
                        {{ csrf_field() }}
                        <button class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Eliminar este agendamento?');">
                            Eliminar
                        </button>
                    </form>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                    Nenhum agendamento configurado.
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}
