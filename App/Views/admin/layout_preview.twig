<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Preview</title>

    <!-- Fonte limpa -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-light: #f8f9fa;
            --bg-dark: #111827;
            --text-light: #1f2937;
            --text-dark: #e5e7eb;
            --border-light: #e1e4e8;
            --border-dark: #374151;
        }

        /* Dark mode herdado do admin */
        body.dark-mode {
            background: var(--bg-dark);
            color: var(--text-dark);
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background: var(--bg-light);
            color: var(--text-light);
            transition: background-color .25s ease, color .25s ease;
        }

        .preview-wrapper {
            width: 100%;
            height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        iframe, embed {
            width: 100%;
            height: 100%;
            border: 0;
        }

        .fallback {
            padding: 40px;
            text-align: center;
            color: #6c757d;
        }

        .fallback a {
            margin-top: 15px;
        }

        /* Cartão premium */
        .fallback-card {
            background: #fff;
            border: 1px solid var(--border-light);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            max-width: 420px;
            margin: auto;
            transition: background-color .25s ease, border-color .25s ease;
        }

        body.dark-mode .fallback-card {
            background: #1f2937;
            border-color: var(--border-dark);
            color: var(--text-dark);
        }

        /* Botão premium */
        .btn-download {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 18px;
            background: #1ABC9C;
            color: #fff;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color .2s ease;
        }

        .btn-download:hover {
            background: #48C9B0;
        }
    </style>

    {% block head %}{% endblock %}
</head>

<body class="{{ app.session.get('darkMode') ? 'dark-mode' : '' }}">

<div class="preview-wrapper">
    {% block content %}{% endblock %}
</div>

</body>
</html>
