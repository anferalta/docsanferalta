{% extends "@admin/layout.twig" %}

{% block page_title %}
    <i class="bi bi-trash"></i> Apagar Estado
{% endblock %}

{% block content %}

<div class="card p-4">

    <h4 class="mb-3">Confirmar eliminação</h4>

    <p class="text-muted">
        Tem a certeza que pretende eliminar o estado:
        <strong>{{ estado.nome }}</strong>?
    </p>

    <p class="text-danger">
        Esta ação é irreversível.
    </p>

    <form method="POST" action="/admin/documento-estados/apagar/{{ estado.id }}">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">

        <button class="btn btn-danger">
            <i class="bi bi-trash"></i> Apagar definitivamente
        </button>

        <a href="/admin/documento-estados" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>

{% endblock %}
