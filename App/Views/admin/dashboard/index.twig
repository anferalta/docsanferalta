{% extends '@admin/layout.twig' %}
{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-4"><div><h3 class="mb-1">{{ isAdmin?'Dashboard administrativo':'O seu dashboard' }}</h3><p class="text-muted mb-0">{{ isAdmin?'Visão global dos utilizadores, documentos e prazos.':'Resumo dos documentos criados pela sua conta.' }}</p></div><small class="text-muted">Atualizado em {{ geradoEm|date('d/m/Y H:i') }}</small></div>
{% if isAdmin %}
<section class="mb-4" aria-labelledby="titulo_sla"><h4 id="titulo_sla">Prazos SLA</h4><p class="text-muted small">Fluxo ativo: novo, pendente, análise, em tramitação e concluído. Alerta nos dois dias após o prazo.</p>
<div class="row g-3">
{% for chave,rotulo in {'ok':'Dentro do prazo','alerta':'Alerta','atrasado':'Atrasado','indefinido':'Indefinido'} %}<div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><h5 class="fs-6">{{ rotulo }}</h5><strong class="display-6">{{ sla[chave] }}</strong><meter class="dashboard-meter" min="0" max="{{ max(1,documentos.fluxo) }}" value="{{ sla[chave] }}" aria-label="{{ rotulo }}">{{ sla[chave] }}</meter></div></div></div>{% endfor %}
</div></section>
<div class="row g-3 mb-4">
<section class="col-lg-6"><div class="card h-100"><div class="card-body"><h4 class="h5">Utilizadores</h4><dl class="dashboard-stats mb-0">{% for chave,rotulo in {'total':'Total','ativos':'Ativos','pendentes':'Pendentes','bloqueados':'Bloqueados'} %}<div><dt>{{ rotulo }}</dt><dd>{{ utilizadores[chave] }}</dd></div>{% endfor %}</dl><a href="/admin/utilizadores" class="btn btn-sm btn-outline-primary mt-3">Gerir utilizadores</a></div></div></section>
<section class="col-lg-6"><div class="card h-100"><div class="card-body"><h4 class="h5">Documentos</h4><dl class="dashboard-stats mb-0">{% for chave,rotulo in {'total':'Total','fluxo':'Tramitação — fluxo ativo','novo':'Novos','pendente':'Pendentes','analise':'Em análise','em_tramitacao':'Em tramitação','concluido':'Concluídos','arquivado':'Arquivados','devolvido':'Devolvidos'} %}<div><dt>{{ rotulo }}</dt><dd>{{ documentos[chave] }}</dd></div>{% endfor %}</dl></div></div></section>
</div>
<section class="card mb-4"><div class="card-body"><h4 class="h5">Áreas e SLA</h4><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Área</th><th>Total</th><th>Dentro do prazo</th><th>Alerta</th><th>Atrasado</th><th>Indefinido</th></tr></thead><tbody>
{% for area in rankingAreas %}<tr><th scope="row">{{ area.area }}</th>{% for chave in ['total','ok','alerta','atrasado','indefinido'] %}<td>{{ area[chave] }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="6">Sem documentos no fluxo ativo.</td></tr>{% endfor %}
</tbody></table></div><a href="/admin/relatorios" class="btn btn-sm btn-outline-primary">Abrir relatórios SLA</a></div></section>
<section class="card mb-4"><div class="card-body"><h4 class="h5">Novos utilizadores — últimos 12 meses</h4><div class="dashboard-months">{% for mes in meses %}<div><span class="small">{{ mes.mes }}</span><meter min="0" max="{{ maxRegistos }}" value="{{ mes.total }}" aria-label="Registos em {{ mes.mes }}">{{ mes.total }}</meter><strong>{{ mes.total }}</strong></div>{% endfor %}</div></div></section>
<div class="row g-3">
{% for tipo,titulo in {'ultimosDocs':'Documentos recentes','ultimosUsers':'Utilizadores recentes','ultimosLogs':'Auditoria recente'} %}
<section class="col-xl-4"><div class="card h-100"><div class="card-body"><h4 class="h5">{{ titulo }}</h4><ul class="list-group list-group-flush">{% set lista=tipo=='ultimosDocs'?ultimosDocs:(tipo=='ultimosUsers'?ultimosUsers:ultimosLogs) %}{% for item in lista %}<li class="list-group-item dashboard-recent"><span>{{ tipo=='ultimosDocs'?item.titulo:(tipo=='ultimosUsers'?item.nome:item.acao) }}</span><small class="text-muted d-block">{{ item.criado_em ?: 'Sem data' }}</small></li>{% else %}<li class="list-group-item">Sem registos.</li>{% endfor %}</ul></div></div></section>
{% endfor %}
</div>
{% else %}
<div class="row g-3">
{% for chave,rotulo in {'total':'Documentos criados','pendente':'Pendentes','concluido':'Concluídos'} %}<div class="col-md-4"><div class="card h-100"><div class="card-body"><h4 class="h6">{{ rotulo }}</h4><strong class="display-5">{{ documentos[chave] }}</strong></div></div></div>{% endfor %}
</div>
{% if isGranted('admin.documentos.ver') %}<a href="/admin/documentos" class="btn btn-primary mt-4">Abrir documentos</a>{% endif %}
{% endif %}
{% endblock %}
