{% extends "@admin/layout.twig" %}

{% block content %}

<div class="container-fluid">

    <!-- TÍTULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">
            <i class="fa fa-chart-line me-2"></i> Dashboard Administrativo
        </h4>
    </div>

    {% if isAdmin %}

    <!-- ============================================================
         CARTÕES DE SLA
    ============================================================ -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-success">Dentro do Prazo</h5>
                    <p class="display-5 text-success fw-bold">{{ slaOk }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-warning">A Expirar</h5>
                    <p class="display-5 text-warning fw-bold">{{ slaAlerta }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h5 class="text-danger">Atrasados</h5>
                    <p class="display-5 text-danger fw-bold">{{ slaAtrasado }}</p>
                </div>
            </div>
        </div>

    </div>

    <!-- ============================================================
         GRÁFICO DE SLA
    ============================================================ -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="mb-3"><i class="fa fa-chart-pie me-2"></i>Distribuição SLA</h5>
            <canvas id="graficoSLA" height="120"></canvas>
        </div>
    </div>

    <!-- ============================================================
         RANKING DE ÁREAS
    ============================================================ -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="mb-3"><i class="fa fa-trophy me-2"></i>Ranking de Áreas (SLA)</h5>

            <table class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Área</th>
                        <th>Total</th>
                        <th>Dentro do Prazo</th>
                        <th>Atrasados</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in rankingAreas %}
                        <tr>
                            <td>{{ r.area }}</td>
                            <td>{{ r.total }}</td>
                            <td>
                                <span class="badge bg-success">{{ r.dentro_prazo }}</span>
                            </td>
                            <td>
                                <span class="badge bg-danger">{{ r.atrasados }}</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">Nenhuma área encontrada.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>

    <!-- ============================================================
         OUTRAS ESTATÍSTICAS (UTILIZADORES E DOCUMENTOS)
    ============================================================ -->
    <div class="row">

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="mb-3"><i class="fa fa-users me-2"></i>Utilizadores</h5>

                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between">
                            Total <span class="fw-bold">{{ totalUtilizadores }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Ativos <span class="fw-bold text-success">{{ totalAtivos }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Pendentes <span class="fw-bold text-warning">{{ totalPendentes }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Bloqueados <span class="fw-bold text-danger">{{ totalBloqueados }}</span>
                        </li>
                    </ul>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="mb-3"><i class="fa fa-file-alt me-2"></i>Documentos</h5>

                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between">
                            Total <span class="fw-bold">{{ totalDocumentos }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Pendentes <span class="fw-bold text-warning">{{ totalDocsPendentes }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Em Tramitação <span class="fw-bold text-primary">{{ totalDocsTramitacao }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Em Análise <span class="fw-bold text-info">{{ totalDocsAnalise }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Concluídos <span class="fw-bold text-success">{{ totalDocsConcluidos }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Arquivados <span class="fw-bold text-secondary">{{ totalDocsArquivados }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Devolvidos <span class="fw-bold text-danger">{{ totalDocsDevolvidos }}</span>
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>

    {% else %}

    <!-- ============================================================
         DASHBOARD DO UTILIZADOR NORMAL
    ============================================================ -->

    <div class="row">

        <div class="col-md-6">
            <div class="card border-primary shadow-sm mb-4">
                <div class="card-body text-center">
                    <h5 class="text-primary">Documentos Criados</h5>
                    <p class="display-5 fw-bold">{{ totalDocsDoUtilizador }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-warning shadow-sm mb-4">
                <div class="card-body text-center">
                    <h5 class="text-warning">Pendentes</h5>
                    <p class="display-5 fw-bold">{{ docsUserPendentes }}</p>
                </div>
            </div>
        </div>

    </div>

    {% endif %}

</div>

{% endblock %}

{% block scripts %}

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('graficoSLA');

new Chart(ctx, {
    type: 'doughnut',
    data: {
        labels: ['Dentro do Prazo', 'A Expirar', 'Atrasados'],
        datasets: [{
            data: [{{ slaOk }}, {{ slaAlerta }}, {{ slaAtrasado }}],
            backgroundColor: ['#28a745', '#ffc107', '#dc3545']
        }]
    }
});
</script>

{% endblock %}
