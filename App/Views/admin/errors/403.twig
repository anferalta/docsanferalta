{% extends "@admin/layout.twig" %}

{% block content %}
<div class="card border-warning shadow-sm">
    <div class="card-header bg-warning text-dark">
        <strong>403 — Sem permissão</strong>
    </div>

    <div class="card-body">
        <p class="mb-3">
            Não tem permissão para aceder a esta funcionalidade.
        </p>

        <p class="text-muted small">
            Se acha que isto é um erro, contacte o administrador do sistema.
        </p>

        <a href="/admin" class="btn btn-warning">Voltar ao painel</a>
    </div>
</div>
{% endblock %}
