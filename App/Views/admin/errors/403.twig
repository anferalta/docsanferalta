{% extends "@admin/layout.twig" %}

{% block content %}
<div class="card border-warning shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <strong>403 — Sem permissão</strong>
    </div>

    <div class="card-body">
        <p class="mb-3">
            Não tem permissão para aceder a esta funcionalidade.
        </p>

        {% if mensagem %}
            <p class="text-muted small">
                Permissão necessária: <strong>{{ mensagem }}</strong>
            </p>
        {% endif %}

        <p class="text-muted small">
            Se acha que isto é um erro, contacte o administrador do sistema.
        </p>

        <div class="mt-3 d-flex gap-2">
            <button onclick="history.back()" class="btn btn-secondary">
                Voltar atrás
            </button>

            <a href="/admin" class="btn btn-warning">
                Ir para o painel
            </a>
        </div>
    </div>
</div>
{% endblock %}
