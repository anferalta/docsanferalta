{% extends "@admin/layout.twig" %}

{% block content %}
<div class="card border-danger shadow-sm">
    <div class="card-header bg-danger text-white">
        <strong>500 — Erro interno</strong>
    </div>

    <div class="card-body">
        <p class="mb-3">
            Ocorreu um erro inesperado ao processar o pedido.
        </p>

        {% if mensagem is defined %}
            <p class="text-muted small">
                Detalhes técnicos: {{ mensagem }}
            </p>
        {% endif %}

        <a href="/admin" class="btn btn-danger">Voltar ao painel</a>
    </div>
</div>
{% endblock %}

