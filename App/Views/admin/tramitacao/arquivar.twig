<!-- MODAL ARQUIVAR DOCUMENTO -->
<div class="modal fade" id="modalArquivar" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form method="POST"
              action="/admin/tramitacao/arquivar"
              class="modal-content"
              id="formArquivar">

            {{ csrf_field() }}

            <input type="hidden" name="documento_id" value="{{ documento.id }}">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fa fa-archive me-2"></i> Arquivar Documento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <p class="mb-3">
                    Tem a certeza que pretende <strong>arquivar este documento</strong>?
                </p>

                <p class="text-muted">
                    O documento será movido para a área de arquivados e deixará de estar em tramitação.
                </p>

                <!-- COMENTÁRIO OPCIONAL -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Comentário (opcional)</label>
                    <textarea name="comentario"
                              class="form-control"
                              rows="3"
                              placeholder="Descreva o motivo do arquivamento (opcional)..."></textarea>
                </div>

            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-danger" id="btnArquivar">
                    <i class="fa fa-archive me-1"></i> Arquivar Documento
                </button>
            </div>

        </form>
    </div>
</div>

<script>
document.getElementById('formArquivar').addEventListener('submit', function () {
    const btn = document.getElementById('btnArquivar');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> A arquivar...';
});
</script>
