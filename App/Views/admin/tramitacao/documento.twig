{% extends "@admin/layout.twig" %}

{% block page_title %}
    <i class="fa fa-diagram-project"></i> Tramitação — Documento #{{ documento.id }}
{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- TÍTULO + BOTÃO VOLTAR -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="fa fa-file-text me-2"></i> Documento: {{ documento.titulo }}
        </h4>
        <a href="/admin/tramitacao" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <!-- CARTÃO DO DOCUMENTO -->
    <div class="card mb-4">
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <p><strong>Tipo:</strong> {{ documento.tipo_nome }}</p>
                    <p>
                        <strong>Estado atual:</strong>
                        <span class="badge-estado badge-{{ documento.estado_atual }}">
                            {{ documento.estado_atual|replace({'_':' '})|upper }}
                        </span>
                    </p>
                </div>

                <div class="col-md-6">
                    <p><strong>Área atual:</strong> {{ documento.area_nome }}</p>
                    <p><strong>Criado por:</strong> {{ documento.criador_nome }}</p>
                </div>
            </div>

            {% if anexos|length > 0 %}
                <a href="/admin/documentos/anexo/abrir/{{ anexos[0].id }}"
                   target="_blank"
                   class="btn btn-outline-primary mt-2">
                    <i class="fa fa-file me-1"></i> Ver Documento
                </a>
            {% endif %}

        </div>
    </div>

    <!-- FICHEIROS DO DOCUMENTO -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fa fa-paperclip me-2"></i> Ficheiros Anexados</h5>
        </div>

        <div class="card-body">

            {% if anexos|length == 0 %}
                <p class="text-muted">Nenhum ficheiro anexado.</p>
            {% else %}
                <ul class="list-group">

                    {% for f in anexos %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">

                            <span>
                                <i class="fa fa-file me-2"></i> {{ f.nome_original }}
                            </span>

                            <div class="d-flex gap-2">

                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary btn-preview-inline"
                                        data-bs-toggle="modal"
                                        data-bs-target="#previewModal"
                                        data-url="/admin/documentos/anexo/abrir/{{ f.id }}"
                                        data-ext="{{ f.ficheiro_original|lower|split('.')|last }}"
                                        data-preview-url="{% if f.ficheiro_original|lower|split('.')|last in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/documentos/preview-pdf/{{ f.id }}{% endif %}"
                                        data-mime="{{ f.mime_type }}">
                                    <i class="fa fa-eye me-1"></i> Preview
                                </button>

                                <a href="/admin/documentos/preview/{{ f.id }}"
                                   target="_blank"
                                   class="btn btn-sm btn-primary">
                                    Abrir
                                </a>

                            </div>

                        </li>
                    {% endfor %}

                </ul>
            {% endif %}

        </div>
    </div>

    <!-- HISTÓRICO DE TRAMITAÇÃO -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fa fa-history me-2"></i> Histórico de Tramitação</h5>
        </div>

        <div class="card-body">

            {% if historico is empty %}
                <p class="text-muted">Ainda não existem movimentos neste documento.</p>
            {% else %}

                <div class="timeline">

                    {% for h in historico %}
                        <div class="timeline-item">

                            <div class="timeline-icon bg-primary text-white">
                                {% if h.acao == 'ENCAMINHADO' %}
                                    <i class="fa fa-random"></i>
                                {% elseif h.acao == 'COMENTARIO' %}
                                    <i class="fa fa-comment"></i>
                                {% elseif h.acao == 'ESTADO' %}
                                    <i class="fa fa-flag"></i>
                                {% else %}
                                    <i class="fa fa-circle"></i>
                                {% endif %}
                            </div>

                            <div class="timeline-content">

                                <h6 class="mb-1">
                                    {{ h.utilizador_nome }}
                                    <small class="text-muted">— {{ h.criado_em|date("d/m/Y H:i") }}</small>
                                </h6>

                                <p class="mb-1">
                                    {% if h.acao == 'ENCAMINHADO' %}
                                        Documento encaminhado para <strong>{{ h.area_nome }}</strong>.
                                    {% elseif h.acao == 'COMENTARIO' %}
                                        Comentário adicionado.
                                    {% elseif h.acao == 'ESTADO' %}
                                        Estado alterado para
                                        <span class="badge-estado badge-{{ h.estado }}">
                                            {{ h.estado|replace({'_':' '})|upper }}
                                        </span>.
                                    {% endif %}
                                </p>

                                {% if h.comentario %}
                                    <div class="alert alert-secondary py-2 px-3 mb-2">
                                        {{ h.comentario }}
                                    </div>
                                {% endif %}

                                {% if h.anexos is defined and h.anexos %}
                                    <div class="mt-2">
                                        <strong>Anexos:</strong>
                                        <ul class="list-unstyled ms-2">

                                            {% for a in h.anexos %}
                                                <li class="d-flex align-items-center gap-2">

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary btn-preview-inline"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#previewModal"
                                                            data-url="/admin/tramitacao/anexo/abrir/{{ a.id }}"
                                                            data-ext="{{ a.ficheiro_original|lower|split('.')|last }}"
                                                            data-preview-url="{% if a.ficheiro|lower|split('.')|last in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/tramitacao/anexo/preview-pdf/{{ a.id }}{% endif %}"
                                                            data-mime="{{ a.mime_type }}">
                                                        <i class="fa fa-eye me-1"></i> Preview
                                                    </button>

                                                    <a href="{% if a.ficheiro|lower|split('.')|last in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/tramitacao/anexo/preview-pdf/{{ a.id }}{% else %}/admin/tramitacao/anexo/abrir/{{ a.id }}{% endif %}"
                                                       target="_blank"
                                                       class="btn btn-sm btn-primary">
                                                        Abrir
                                                    </a>

                                                    <span>{{ a.nome_original }}</span>

                                                </li>
                                            {% endfor %}

                                        </ul>
                                    </div>
                                {% endif %}

                            </div>
                        </div>
                    {% endfor %}

                </div>

            {% endif %}

        </div>
    </div>

    <!-- BOTÕES DE AÇÃO -->
    <div class="d-flex gap-2 mb-4">

        {% if user.hasPermissao('admin.tramitacao.encaminhar') %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTramitar">
                <i class="fa fa-random me-1"></i> Encaminhar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.comentar') %}
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalComentar">
                <i class="fa fa-comment me-1"></i> Comentar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.estado') %}
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEstado">
                <i class="fa fa-flag me-1"></i> Alterar Estado
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.estado') and documento.estado_atual in ['pendente','analise','em_tramitacao','concluido'] %}
            <form action="/admin/tramitacao/arquivar" method="post" class="d-inline">
                {{ csrf_field() }}
                <input type="hidden" name="documento_id" value="{{ documento.id }}">
                <button type="submit" class="btn btn-dark">
                    <i class="fa fa-archive me-1"></i> Arquivar
                </button>
            </form>
        {% endif %}

    </div>

    {% include "@admin/tramitacao/modais.twig" %}

</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.btn-preview-inline').forEach(function (button) {
        button.addEventListener('click', function () {
            const frame = document.getElementById('previewFrame');
            if (!frame) return;

            const url = button.getAttribute('data-url') || '';
            const previewUrl = button.getAttribute('data-preview-url') || '';
            const ext = (button.getAttribute('data-ext') || '').toLowerCase();
            if (['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx'].includes(ext) && previewUrl) {
                frame.src = previewUrl;
                return;
            }

            frame.src = url;
        });
    });

    const form = document.getElementById('formEncaminhar');
    const btn = document.getElementById('btnTramitar');
    const modalEl = document.getElementById('modalTramitar');

    if (form && btn && modalEl) {
        form.addEventListener('submit', function () {

            try {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            } catch (e) {}

            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> A enviar...';
        });
    }

});
</script>
{% endblock %}

{% block modals %}
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog m-0" style="width:100vw;max-width:100vw;height:100vh">
        <div class="modal-content" style="height:100vh;border:0;border-radius:0">
            <div class="modal-header">
                <h5 class="modal-title">Preview do ficheiro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0" style="height:calc(100vh - 56px);min-height:0;overflow:auto">
                <iframe id="previewFrame" src="" title="Preview do ficheiro"
                        style="width:100%;height:100%;border:0"></iframe>
            </div>
        </div>
    </div>
</div>
{% endblock %}
