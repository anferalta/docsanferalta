{% extends "@admin/layout.twig" %}
{% block title %}Permissões do perfil{% endblock %}
{% block header %}Gestão de Perfis{% endblock %}
{% block content %}
<h3 class="mb-3">Permissões — {{ perfil.nome }}</h3>
<p class="text-muted">As alterações só são aplicadas ao guardar. Desmarcar todas as opções remove todas as permissões deste perfil.</p>
{% if erro %}<div class="alert alert-danger" role="alert">{{ erro }}</div>{% endif %}
<form method="post" action="/admin/perfis/permissoes/{{ perfil.id }}" id="permissoes_perfil">
    {{ csrf_field() }}
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-secondary" data-selecionar="true">Selecionar tudo</button>
        <button type="button" class="btn btn-sm btn-secondary" data-selecionar="false">Desmarcar tudo</button>
    </div>
    <div class="row">
    {% for grupo, lista in todas %}
        <div class="col-md-4 mb-4"><fieldset class="card shadow-sm h-100">
            <legend class="card-header fs-6 fw-bold mb-0">{{ grupo ?: 'Outras' }}</legend>
            <div class="card-body">
            {% for p in lista %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="permissoes[]" value="{{ p.id }}" id="perm{{ p.id }}" {{ p.id in atuais ? 'checked' : '' }}>
                    <label class="form-check-label" for="perm{{ p.id }}">{{ p.nome }} <small class="text-muted">({{ p.codigo }})</small></label>
                </div>
            {% endfor %}
            </div>
        </fieldset></div>
    {% else %}
        <p class="text-muted">Não existem permissões disponíveis.</p>
    {% endfor %}
    </div>
    <button type="submit" class="btn btn-primary">Guardar permissões</button>
    <a href="/admin/perfis" class="btn btn-secondary">Voltar</a>
</form>
<script>
(() => {
    const form = document.getElementById('permissoes_perfil');
    form.querySelectorAll('[data-selecionar]').forEach(button => {
        button.addEventListener('click', () => {
            form.querySelectorAll('input[name="permissoes[]"]').forEach(checkbox => {
                checkbox.checked = button.dataset.selecionar === 'true';
            });
        });
    });
})();
</script>
{% endblock %}
