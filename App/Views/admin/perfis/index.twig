{% extends "@admin/layout.twig" %}
{% block title %}Perfis{% endblock %}
{% block header %}Gestão de Perfis{% endblock %}
{% block content %}
{% set podeCriar = isGranted('admin.perfis.criar') %}
{% set podeEditar = isGranted('admin.perfis.editar') %}
{% set podePermissoes = isGranted('admin.perfis.permissoes') %}
{% set podeApagar = isGranted('admin.perfis.apagar') %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h3 class="mb-1">Perfis</h3><p class="text-muted mb-0">Gerir perfis de acesso e permissões. Total: {{ perfis|length }}.</p></div>
    {% if podeCriar %}<a href="/admin/perfis/criar" class="btn btn-primary">Novo perfil</a>{% endif %}
</div>
<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th scope="col">ID</th><th scope="col">Nome</th><th scope="col">Descrição</th><th scope="col">Utilizadores</th><th scope="col">Permissões</th><th scope="col">Ações</th></tr></thead>
    <tbody>
    {% for p in perfis %}
        <tr>
            <td>{{ p.id }}</td><td>{{ p.nome }}</td><td>{{ p.descricao ?: '—' }}</td>
            <td>{{ p.total_utilizadores }}</td><td>{{ p.total_permissoes }}</td>
            <td>
                {% if p.id == 1 %}
                    <span class="badge bg-secondary">Administrador protegido</span>
                {% else %}
                    <div class="d-flex flex-wrap gap-2">
                    {% if podePermissoes %}<a href="/admin/perfis/permissoes/{{ p.id }}" class="btn btn-sm btn-warning">Gerir permissões</a>{% endif %}
                    {% if podeEditar %}<a href="/admin/perfis/editar/{{ p.id }}" class="btn btn-sm btn-secondary">Editar</a>{% endif %}
                    {% if podeApagar %}
                        {% if p.total_utilizadores > 0 %}
                            <span class="text-muted small align-self-center">Em utilização: não pode ser apagado.</span>
                        {% else %}
                            <form method="post" action="/admin/perfis/apagar/{{ p.id }}" class="d-inline" onsubmit="return confirm('Tem a certeza que deseja apagar este perfil?')">
                                {{ csrf_field() }}<button type="submit" class="btn btn-sm btn-danger">Apagar</button>
                            </form>
                        {% endif %}
                    {% endif %}
                    </div>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="text-center text-muted">Nenhum perfil encontrado.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
