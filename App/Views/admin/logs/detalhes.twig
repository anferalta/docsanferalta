{% extends "@admin/layout.twig" %}
{% block title %}Detalhes do Log{% endblock %}
{% block header %}Gestão de Logs{% endblock %}
{% block content %}
<h3 class="mb-4">Detalhes do Log #{{ log.id }}</h3>
<div class="card shadow-sm"><div class="card-body">
<dl class="row" style="overflow-wrap:anywhere">
    {% for campo, rotulo in {'tipo':'Tipo','mensagem':'Mensagem','ficheiro':'Ficheiro','linha':'Linha','ip':'IP','criado_em':'Data','url':'URL','metodo':'Método HTTP','utilizador_id':'Utilizador ID','user_agent':'User Agent'} %}
        <dt class="col-md-3 text-muted">{{ rotulo }}</dt><dd class="col-md-9">{{ log[campo] is not null and log[campo] != '' ? log[campo] : '—' }}</dd>
    {% endfor %}
</dl>
<h5>Detalhes</h5><pre class="p-3 bg-light border rounded" style="max-height:400px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere">{{ log.detalhes ?: 'Sem detalhes adicionais.' }}</pre>
<div class="mt-4 d-flex flex-wrap justify-content-between gap-2">
    <a href="/admin/logs?{{ filtros|merge({'p':pagina})|url_encode }}" class="btn btn-outline-secondary">Voltar aos resultados</a>
    {% if isGranted('admin.logs.exportar') %}<a href="/admin/logs/exportar?id={{ log.id }}" class="btn btn-success">Exportar este log</a>{% endif %}
</div>
</div></div>
{% endblock %}
