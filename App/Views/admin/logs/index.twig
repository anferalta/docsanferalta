{% extends "@admin/layout.twig" %}
{% block title %}Logs do Sistema{% endblock %}
{% block header %}Gestão de Logs{% endblock %}
{% block content %}
<h3 class="mb-4">Logs do Sistema</h3>
{% set podeExportar = isGranted('admin.logs.exportar') %}
<div class="card mb-3"><div class="card-body">
<form method="get" action="/admin/logs" class="row g-3 align-items-end">
    <div class="col-md-2"><label for="log_tipo" class="form-label">Tipo</label><select id="log_tipo" name="tipo" class="form-select">
        <option value="">Todos</option>
        {% if filtros.tipo != '' and filtros.tipo not in tipos %}<option value="{{ filtros.tipo }}" selected>{{ filtros.tipo }}</option>{% endif %}
        {% for tipo in tipos %}<option value="{{ tipo }}" {{ filtros.tipo == tipo ? 'selected' : '' }}>{{ tipo }}</option>{% endfor %}
    </select></div>
    <div class="col-md-2"><label for="log_ip" class="form-label">IP</label><input id="log_ip" type="text" name="ip" value="{{ filtros.ip }}" maxlength="45" class="form-control" placeholder="IPv4 ou IPv6"></div>
    {% for campo, rotulo in {'data_inicio':'Data início','data_fim':'Data fim'} %}
    <div class="col-md-2"><label for="log_{{ campo }}" class="form-label">{{ rotulo }}</label><input id="log_{{ campo }}" type="date" name="{{ campo }}" value="{{ filtros[campo] }}" class="form-control"></div>
    {% endfor %}
    <div class="col-md-3"><label for="log_mensagem" class="form-label">Mensagem contém</label><input id="log_mensagem" type="text" name="mensagem" value="{{ filtros.mensagem }}" maxlength="500" class="form-control"></div>
    <div class="col-md-1 d-grid"><button type="submit" class="btn btn-primary">Filtrar</button></div>
</form>
<div class="mt-3 d-flex flex-wrap justify-content-between gap-2">
    <small class="text-muted">{{ total }} registo(s) encontrado(s). A mostrar {{ logs|length }}. Página {{ pagina }} de {{ paginas }}.</small>
    <div>{% if podeExportar %}<a href="/admin/logs/exportar?{{ filtros|url_encode }}" class="btn btn-sm btn-success">Exportar CSV</a>{% endif %} <a href="/admin/logs" class="btn btn-sm btn-outline-secondary">Limpar filtros</a></div>
</div>
</div></div>
<div class="table-responsive"><table class="table table-striped table-hover align-middle">
    <thead><tr><th scope="col">ID</th><th scope="col">Tipo</th><th scope="col">Mensagem</th><th scope="col">IP</th><th scope="col">Data</th><th scope="col">Detalhes</th></tr></thead>
    <tbody>
    {% for log in logs %}
    <tr><td>{{ log.id }}</td><td><span class="badge bg-{{ log.tipo in ['erro','fatal','backup_erro','error'] ? 'danger' : (log.tipo == 'excecao' ? 'warning text-dark' : (log.tipo == 'aviso' ? 'info text-dark' : (log.tipo == 'debug' ? 'secondary' : 'primary'))) }}">{{ log.tipo }}</span></td>
        <td style="overflow-wrap:anywhere" title="{{ log.mensagem|slice(0,500) }}">
            {% set limite = filtros.mensagem != '' ? 500 : 60 %}{% set msg = log.mensagem|slice(0,limite) %}
            {% if filtros.mensagem != '' %}
                {% for parte in msg|split(filtros.mensagem) %}{{ parte }}{% if not loop.last %}<mark>{{ filtros.mensagem }}</mark>{% endif %}{% endfor %}
            {% else %}{{ msg }}{% endif %}{{ log.mensagem|length > limite ? '…' : '' }}
        </td>
        <td>{{ log.ip ?: '—' }}</td><td class="text-nowrap">{{ log.criado_em ?: '—' }}</td>
        <td><a href="/admin/logs/{{ log.id }}?{{ filtros|merge({'p':pagina})|url_encode }}" class="btn btn-sm btn-outline-secondary">Ver</a></td>
    </tr>
    {% else %}<tr><td colspan="6" class="text-center text-muted py-4">Nenhum registo encontrado com os filtros atuais.</td></tr>{% endfor %}
    </tbody>
</table></div>
{% if paginas > 1 %}
<nav aria-label="Paginação dos logs"><ul class="pagination flex-wrap">
    <li class="page-item {{ pagina == 1 ? 'disabled' : '' }}">{% if pagina > 1 %}<a class="page-link" href="?{{ filtros|merge({'p':pagina-1})|url_encode }}">Anterior</a>{% else %}<span class="page-link">Anterior</span>{% endif %}</li>
    {% set inicio = max(1,pagina-2) %}{% set fim = min(paginas,pagina+2) %}
    {% if inicio > 1 %}<li class="page-item"><a class="page-link" href="?{{ filtros|merge({'p':1})|url_encode }}">1</a></li>{% endif %}
    {% if inicio > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
    {% for p in inicio..fim %}<li class="page-item {{ p == pagina ? 'active' : '' }}"><a class="page-link" {% if p == pagina %}aria-current="page"{% endif %} href="?{{ filtros|merge({'p':p})|url_encode }}">{{ p }}</a></li>{% endfor %}
    {% if fim < paginas-1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
    {% if fim < paginas %}<li class="page-item"><a class="page-link" href="?{{ filtros|merge({'p':paginas})|url_encode }}">{{ paginas }}</a></li>{% endif %}
    <li class="page-item {{ pagina == paginas ? 'disabled' : '' }}">{% if pagina < paginas %}<a class="page-link" href="?{{ filtros|merge({'p':pagina+1})|url_encode }}">Seguinte</a>{% else %}<span class="page-link">Seguinte</span>{% endif %}</li>
</ul></nav>
{% endif %}
{% endblock %}
