<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">

    <title>{% block title %}Admin{% endblock %}</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- CSS do sistema -->
    <link rel="stylesheet" href="/assets/css/logs.css">
    <link rel="stylesheet" href="/assets/css/admin.css?v={{ random() }}">
    <link rel="stylesheet" href="/assets/css/badges.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Inter:wght@300;400;500;600&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    {% block head %}{% endblock %}
</head>

<body>

<div class="admin-wrapper d-flex">

    <!-- SIDEBAR -->
    <aside id="sidebar-wrapper">
        <div id="sidebar" class="sidebar">

            <div class="logo">Painel Admin</div>

            <nav class="sidebar-nav">
                <ul>

                    {% for item in menuAdmin %}

                        {% if item.header is defined %}
                            <li class="menu-header">{{ item.header }}</li>
                        {% else %}

                            {% if auth.user.isAdmin() or item.permissao is not defined or auth.user.hasPermissao(item.permissao) %}

                                {% set active = (app.request.path starts with item.url) ? 'active' : '' %}
                                {% set open = (item.sub is defined and active) ? 'open' : '' %}

                                <li class="menu-item {{ active }} {{ open }}">

                                    <a href="{{ item.url }}"
                                       class="menu-link {% if item.principal is defined and item.principal %}main{% endif %}">

                                        {% if item.icone is defined %}
                                            <i class="bi {{ item.icone }}"></i>
                                        {% endif %}

                                        <span>{{ item.titulo }}</span>

                                        {% if item.badge is defined and item.badge > 0 %}
                                            <span class="badge">{{ item.badge }}</span>
                                        {% endif %}

                                        {% if item.sub is defined %}
                                            <i class="bi bi-chevron-right submenu-arrow"></i>
                                        {% endif %}
                                    </a>

                                    {% if item.sub is defined %}
                                        <ul class="submenu-list">

                                            {% for sub in item.sub %}
                                                {% if auth.user.isAdmin() or auth.user.hasPermissao(sub.permissao) %}

                                                    {% set subActive = (app.request.path == sub.url) ? 'active' : '' %}

                                                    <li class="submenu-item {{ subActive }}">
                                                        <a href="{{ sub.url }}" class="submenu-link">
                                                            {{ sub.titulo }}
                                                        </a>
                                                    </li>

                                                {% endif %}
                                            {% endfor %}

                                        </ul>
                                    {% endif %}

                                </li>

                            {% endif %}
                        {% endif %}

                    {% endfor %}

                </ul>
            </nav>

        </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="content-area flex-grow-1">

        <!-- TOPBAR -->
        <header class="topbar d-flex align-items-center justify-content-between px-4">

            <!-- Botão hambúrguer (mobile) -->
            <button id="btnToggleSidebar" class="btn-toggle-sidebar me-3 d-md-none">
                <i class="bi bi-list"></i>
            </button>

            <div class="page-title flex-grow-1">
                {% block page_title %}{% endblock %}
            </div>

            <!-- CONTROLOS PREMIUM -->
            <div class="d-flex align-items-center gap-2">

                <!-- Dark Mode -->
                <button id="btnDarkMode" class="btn btn-sm btn-outline-secondary" title="Modo Escuro">
                    <i class="bi bi-moon"></i>
                </button>

                <!-- Temas -->
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-primary" data-theme="theme-blue" title="Tema Azul">
                        <i class="bi bi-palette"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-success" data-theme="theme-green" title="Tema Verde">
                        <i class="bi bi-palette"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-theme="theme-gray" title="Tema Cinza">
                        <i class="bi bi-palette"></i>
                    </button>
                </div>

                <!-- User -->
                <div class="dropdown">
                    <a class="user-info d-flex align-items-center gap-2 dropdown-toggle"
                       href="#" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer;">
                        <span class="user-name">{{ auth.user.nome }}</span>
                        <img src="/assets/img/avatar.png" class="avatar rounded-circle">
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/perfil"><i class="bi bi-person"></i> Perfil</a></li>
                        <li><a class="dropdown-item" href="/admin/definicoes"><i class="bi bi-gear"></i> Definições</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Sair</a></li>
                    </ul>
                </div>

            </div>

        </header>

        <!-- CONTEÚDO -->
        <section class="page-content">
            {% include "@admin/flash.twig" %}
            {% block content %}{% endblock %}
        </section>

    </main>

</div>

<!-- OVERLAY -->
<div class="sidebar-overlay"></div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- SIDEBAR TOGGLE -->
<script>
    const toggleBtn = document.getElementById('btnToggleSidebar');
    const overlay = document.querySelector('.sidebar-overlay');

    if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
            document.body.classList.toggle('sidebar-open');
        });
    }

    if (overlay) {
        overlay.addEventListener('click', function () {
            document.body.classList.remove('sidebar-open');
        });
    }
</script>

<!-- SUBMENU + AUTO-CLOSE MOBILE -->
<script>
    document.querySelectorAll('.menu-item').forEach(function (item) {

        const link = item.querySelector('.menu-link');
        const submenu = item.querySelector('.submenu-list');

        if (!submenu)
            return;

        link.addEventListener('click', function (e) {
            e.preventDefault();
            item.classList.toggle('open');

            if (window.innerWidth <= 992) {
                document.body.classList.remove('sidebar-open');
            }
        });

        if (item.classList.contains('active')) {
            item.classList.add('open');
        }
    });
</script>

<!-- ADMIN JS PREMIUM -->
<script src="/assets/js/admin.js?v={{ random() }}"></script>

{% block scripts %}{% endblock %}
{% block modals %}{% endblock %}

</body>
</html>
