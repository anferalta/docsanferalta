<h5 class="mb-3"><i class="fa fa-paperclip me-2"></i> Ficheiros do Documento</h5>

{% if ficheiros|length > 0 %}
    <ul class="list-group mb-4">

        {% for f in ficheiros %}
            <li class="list-group-item d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center">

                    {% set ext = f.ficheiro_original|lower|split('.')|last %}

                    {% include "@admin/documentos/partials/ficheiro_icone.twig" with { ext: ext } %}

                    <span>{{ f.ficheiro_original }}</span>
                </div>

                <div class="d-flex gap-2">

                    {% if ext == 'pdf' %}
                        <a href="/admin/documentos/anexo/abrir/{{ f.id }}"
                           target="_blank"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="fa fa-eye me-1"></i> Preview
                        </a>
                    {% endif %}

                    <a href="/admin/documentos/anexo/abrir/{{ f.id }}"
                       target="_blank"
                       class="btn btn-sm btn-primary">
                        <i class="fa fa-download me-1"></i> Abrir
                    </a>

                    <form action="/admin/documentos/ficheiros/apagar/{{ f.id }}" method="post"
                          onsubmit="return confirm('Tem a certeza que deseja apagar este ficheiro?');">
                        {{ csrf_field() }}
                        <button class="btn btn-sm btn-danger">
                            <i class="fa fa-trash me-1"></i> Apagar
                        </button>
                    </form>

                </div>

            </li>
        {% endfor %}

    </ul>
{% else %}
    <p class="text-muted mb-4">Este documento não tem ficheiros anexados.</p>
{% endif %}

