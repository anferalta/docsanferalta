{% extends "@admin/layout.twig" %}

{% block content %}
    <div class="card">
        <h2>Documentos</h2>

        <a href="{{ url('/admin/documentos/upload') }}" class="btn btn-primary">+ Carregar Documento</a>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Anexos</th>
                    <th>Tipo</th>
                    <th>Criado em</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                {% for d in documentos %}
                    <tr>
                        <td>{{ d.id }}</td>
                        <td>{{ d.titulo }}</td>

                        <td>
                            {% set anexos = d.anexos() %}

                            <span class="badge bg-primary">{{ anexos|length }} anexos</span>

                            {% if anexos %}
                                <ul class="mt-2" style="padding-left: 1rem;">
                                    {% for a in anexos %}
                                        <li class="mb-1">

                                            <i class="fa fa-file me-1"></i>

                                            <a href="/admin/documentos/anexo/abrir/{{ a.id }}"
                                               class="btn btn-sm btn-outline-primary"
                                               target="_blank">
                                                <i class="fa fa-eye"></i> Ver
                                            </a>

                                            <a href="/admin/documentos/anexo/download/{{ a.id }}"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="fa fa-download"></i> Download
                                            </a>

                                            <span class="ms-2">{{ a.nome() }}</span>

                                            <small class="text-muted">
                                                ({{ (a.tamanho / 1024)|number_format(1) }} KB)
                                            </small>

                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </td>

                        <td>{{ d.tipo_nome }}</td>

                        <td>{{ d.criado_em|date("d/m/Y H:i") }}</td>

                        <td>
                            <a href="/admin/documentos/eliminar/{{ d.id }}" class="btn btn-sm btn-danger"
                               onclick="return confirm('Eliminar documento?')">Eliminar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Nenhum documento encontrado.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
