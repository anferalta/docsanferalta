{% extends "@admin/layout.twig" %}

{% block content %}
<div class="card">
    <h2>Documentos</h2>

    <a href="{{ url('/admin/documentos/upload') }}" class="btn btn-primary">+ Carregar Documento</a>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Anexos</th>
                <th>Tipo</th>
                <th>Criado em</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            {% for d in documentos %}
                <tr>
                    <td>{{ d.id }}</td>
                    <td>{{ d.titulo }}</td>

                    <td>
                        {% set anexos = d.anexos() %}
                        {{ anexos|length }} ficheiro(s)

                        <ul class="mt-1">
                            {% for a in anexos %}
                                <li>
                                    <a href="/admin/documentos/anexo/{{ a.id }}" target="_blank">
                                        {{ a.ficheiro|split('/')|last }}
                                        ({{ (a.tamanho / 1024)|number_format(1) }} KB)
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </td>

                    <td>{{ d.tipo_nome }}</td>

                    <td>{{ d.criado_em|date("d/m/Y H:i") }}</td>

                    <td>
                        <a href="/admin/documentos/editar/{{ d.id }}" class="btn btn-sm btn-warning">Editar</a>
                        <a href="/admin/documentos/eliminar/{{ d.id }}" class="btn btn-sm btn-danger"
                           onclick="return confirm('Eliminar documento?')">Eliminar</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Nenhum documento encontrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
