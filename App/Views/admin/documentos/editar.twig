{% extends "@admin/layout.twig" %}

{% block page_title %}
    <i class="fa fa-folder-open"></i> Documento #{{ documento.id }}
{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/admin/tramitacao">Tramitação</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Documento #{{ documento.id }}
            </li>
        </ol>
    </nav>

    <!-- TÍTULO + BOTÃO VOLTAR -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="fa fa-file-text me-2"></i> Documento: {{ documento.titulo }}
        </h4>
        <a href="/admin/tramitacao" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <!-- ABAS -->
    <ul class="nav nav-tabs mb-4">

        <li class="nav-item">
            <a class="nav-link {{ tab == 'dados' ? 'active' : '' }}"
               href="/admin/documentos/editar/{{ documento.id }}?tab=dados">
                Dados
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link {{ tab == 'ficheiros' ? 'active' : '' }}"
               href="/admin/documentos/editar/{{ documento.id }}?tab=ficheiros">
                Ficheiros
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link {{ tab == 'tramitacao' ? 'active' : '' }}"
               href="/admin/documentos/editar/{{ documento.id }}?tab=tramitacao">
                Tramitação
            </a>
        </li>

    </ul>

    <!-- CONTEÚDO DAS ABAS -->
    <div class="tab-content">

        {% if tab == 'dados' %}
            <!-- CARTÃO DO DOCUMENTO -->
            <div class="card mb-4">
                <div class="card-body">

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Tipo:</strong>
                                {% if documento.tipo_nome %}
                                    {{ documento.tipo_nome }}
                                {% else %}
                                    <span class="text-muted">Não definido</span>
                                {% endif %}
                            </p>

                            <p><strong>Estado atual:</strong>
                                <span class="badge-estado badge-{{ documento.estado_atual }}">
                                    {{ documento.estado_atual|replace({'_':' '})|upper }}
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p><strong>Área atual:</strong>
                                {% if documento.area_nome %}
                                    {{ documento.area_nome }}
                                {% else %}
                                    <span class="text-muted">Sem área definida</span>
                                {% endif %}
                            </p>

                            <p><strong>Criado por:</strong>
                                {% if documento.criador_nome %}
                                    {{ documento.criador_nome }}
                                {% else %}
                                    <span class="text-muted">Desconhecido</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    
                </div>
            </div>
        {% endif %}

        {% if tab == 'ficheiros' %}
            <!-- LISTA DE FICHEIROS -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fa fa-paperclip me-2"></i> Ficheiros Anexados</h5>
                </div>

                <div class="card-body">

                    {% if ficheiros|length > 0 %}
                        <ul class="list-group">

                            {% for f in ficheiros %}
                                {% set nomeAnexo = f.ficheiro_original|default(f.ficheiro|default('')) %}
                                {% set ext = nomeAnexo|lower|split('.')|last %}
                                {% set url = "/admin/documentos/anexo/abrir/" ~ f.id %}
                                {% set previewUrl = ext in ['doc', 'docx'] ? "/admin/documentos/preview-pdf/" ~ f.id : '' %}

                                <li class="list-group-item d-flex justify-content-between align-items-center">

                                    <div class="d-flex align-items-center">

                                        {% if ext == 'pdf' %}
                                            <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                                        {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                            <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                                        {% elseif ext in ['doc','docx'] %}
                                            <i class="fa fa-file-word text-info fa-lg me-2"></i>
                                        {% elseif ext in ['xls','xlsx'] %}
                                            <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                                        {% elseif ext in ['ppt','pptx'] %}
                                            <i class="fa fa-file-powerpoint text-danger fa-lg me-2"></i>
                                        {% elseif ext == 'txt' %}
                                            <i class="fa fa-file-alt text-muted fa-lg me-2"></i>
                                        {% elseif ext in ['zip','rar'] %}
                                            <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                                        {% else %}
                                            <i class="fa fa-file fa-lg me-2"></i>
                                        {% endif %}

                                        <span>{{ nomeAnexo }}</span>
                                    </div>

                                    <div class="d-flex gap-2">

                                        <button type="button"
        				   class="btn btn-sm btn-outline-secondary btn-preview-inline"
        				   data-bs-toggle="modal"
        				   data-bs-target="#previewModal"
  				           data-url="{{ url }}"
    				           data-ext="{{ ext }}"
                                           data-preview-url="{{ previewUrl }}">
   					 <i class="fa fa-eye me-1"></i> Preview
					</button>

                                        <a href="{{ url }}" target="_blank" class="btn btn-sm btn-primary">
                                            <i class="fa fa-download me-1"></i> Abrir
                                        </a>

                                    </div>

                                </li>
                            {% endfor %}

                        </ul>
                    {% else %}
                        <p class="text-muted">Este documento não tem ficheiros anexados.</p>
                    {% endif %}

                </div>
            </div>
        {% endif %}

        {% if tab == 'tramitacao' %}
            {% include "@admin/documentos/tabs/tramitacao.twig" %}
        {% endif %}

    </div>

    <!-- BOTÕES DE AÇÃO -->
    <div class="d-flex gap-2 mb-4">

        {% if user.hasPermissao('admin.tramitacao.encaminhar') %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTramitar">
                <i class="fa fa-random me-1"></i> Encaminhar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.comentar') %}
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalComentar">
                <i class="fa fa-comment me-1"></i> Comentar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.estado') %}
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEstado">
                <i class="fa fa-flag me-1"></i> Alterar Estado
            </button>
        {% endif %}

    </div>

</div>
{% endblock %}

{% block modals %}
    {% include "@admin/tramitacao/modais.twig" %}

    <!-- MODAL DE PREVIEW INLINE -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog m-0" style="width:100vw;max-width:100vw;height:100vh">
            <div class="modal-content" style="height:100vh;border:0;border-radius:0">

                <div class="modal-header">
                    <h5 class="modal-title">Preview do Ficheiro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-0" id="previewContainer"
                     style="height:calc(100vh - 56px);min-height:0;display:flex;align-items:center;justify-content:center;overflow:auto">
                    <p class="text-muted">A carregar preview...</p>
                </div>

            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    const previewModal = document.getElementById('previewModal');
    const previewContainer = document.getElementById('previewContainer');

    previewModal.addEventListener('show.bs.modal', function (event) {

        const button = event.relatedTarget;
        const url = button.getAttribute('data-url');
        const ext = button.getAttribute('data-ext')?.toLowerCase();
        const previewUrl = button.getAttribute('data-preview-url') || '';

        previewContainer.innerHTML = '<p class="text-muted">A carregar preview...</p>';

        if (!ext) {
            previewContainer.innerHTML = `
                <div class="p-5 text-center">
                    <p>Tipo de ficheiro desconhecido.</p>
                    <a href="${url}" class="btn btn-primary" download>Download</a>
                </div>`;
            return;
        }

        if (['jpg','jpeg','png','gif','webp'].includes(ext)) {
            previewContainer.innerHTML = `<img src="${url}" class="img-fluid" style="max-width:100%;max-height:100%;object-fit:contain">`;
            return;
        }

        if (ext === 'pdf') {
            previewContainer.innerHTML = `<embed src="${url}" type="application/pdf" style="width:100%;height:100%;border:0">`;
            return;
        }

        if (ext === 'txt') {
            previewContainer.innerHTML = `<iframe src="${url}" style="width:100%;height:100%;border:0"></iframe>`;
            return;
        }

        if (['doc','docx','xls','xlsx','ppt','pptx'].includes(ext)) {
            if (['doc', 'docx'].includes(ext) && previewUrl) {
                previewContainer.innerHTML = `
                    <iframe src="${previewUrl}" style="width:100%;height:100%;border:0"></iframe>`;
                return;
            }

            const officeUrl =
                "https://view.officeapps.live.com/op/view.aspx?src=" +
                encodeURIComponent(url);

            previewContainer.innerHTML = `
                <iframe src="${officeUrl}" style="width:100%;height:100%;border:0"></iframe>`;
            return;
        }

        previewContainer.innerHTML = `
            <div class="p-5 text-center">
                <p>Preview não disponível.</p>
                <a href="${url}" class="btn btn-primary" download>Download</a>
            </div>`;
    });

});
</script>
{% endblock %}
