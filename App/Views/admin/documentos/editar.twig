{% extends "@admin/layout.twig" %}

{% block page_title %}
    <i class="fa fa-folder-open"></i> Documento #{{ documento.id }}
{% endblock %}

{% block content %}
<div class="container-fluid">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/tramitacao">Tramitação</a></li>
            <li class="breadcrumb-item active" aria-current="page">Documento #{{ documento.id }}</li>
        </ol>
    </nav>

    <!-- TÍTULO + BOTÃO VOLTAR -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="fa fa-file-text me-2"></i> Documento: {{ documento.titulo }}
        </h4>

        <a href="/admin/tramitacao" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <!-- CARTÃO DO DOCUMENTO -->
    <div class="card mb-4">
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">

                    <p><strong>Tipo:</strong>
                        {% if documento.tipo_nome %}
                            {{ documento.tipo_nome }}
                        {% else %}
                            <span class="text-muted">Não definido</span>
                        {% endif %}
                    </p>

                    <p>
                        <strong>Estado atual:</strong>
                        <span class="badge-estado badge-{{ documento.estado_atual }}">
                            {{ documento.estado_atual|replace({'_':' '})|upper }}
                        </span>
                    </p>
                </div>

                <div class="col-md-6">

                    <p><strong>Área atual:</strong>
                        {% if documento.area_nome %}
                            {{ documento.area_nome }}
                        {% else %}
                            <span class="text-muted">Sem área definida</span>
                        {% endif %}
                    </p>

                    <p><strong>Criado por:</strong>
                        {% if documento.criador_nome %}
                            {{ documento.criador_nome }}
                        {% else %}
                            <span class="text-muted">Desconhecido</span>
                        {% endif %}
                    </p>

                </div>
            </div>

            {% if ficheiros|length > 0 %}
                <a href="/admin/documentos/anexo/abrir/{{ ficheiros[0].id }}"
                   target="_blank"
                   class="btn btn-outline-primary mt-2">
                    <i class="fa fa-file me-1"></i> Ver Documento
                </a>
            {% endif %}

        </div>
    </div>

    <!-- LISTA DE FICHEIROS -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fa fa-paperclip me-2"></i> Ficheiros Anexados</h5>
        </div>

        <div class="card-body">

            {% if ficheiros|length > 0 %}
                <ul class="list-group">

                    {% for f in ficheiros %}
                        {% set ext = f.ficheiro_original|lower|split('.')|last %}

                        <li class="list-group-item d-flex justify-content-between align-items-center">

                            <div class="d-flex align-items-center">

                                {% if ext == 'pdf' %}
                                    <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                                {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                    <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                                {% elseif ext in ['doc','docx'] %}
                                    <i class="fa fa-file-word text-info fa-lg me-2"></i>
                                {% elseif ext in ['xls','xlsx'] %}
                                    <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                                {% elseif ext == 'txt' %}
                                    <i class="fa fa-file-alt text-muted fa-lg me-2"></i>
                                {% elseif ext in ['zip','rar'] %}
                                    <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                                {% else %}
                                    <i class="fa fa-file fa-lg me-2"></i>
                                {% endif %}

                                <span>{{ f.ficheiro_original }}</span>
                            </div>

                            <div class="d-flex gap-2">

                                <!-- PREVIEW INLINE -->
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#previewModal"
                                        data-url="/admin/documentos/anexo/abrir/{{ f.id }}"
                                        data-ext="{{ ext }}">
                                    <i class="fa fa-eye me-1"></i> Preview
                                </button>

                                <!-- ABRIR NORMAL -->
                                <a href="/admin/documentos/anexo/abrir/{{ f.id }}"
                                   target="_blank"
                                   class="btn btn-sm btn-primary">
                                    <i class="fa fa-download me-1"></i> Abrir
                                </a>

                            </div>

                        </li>
                    {% endfor %}

                </ul>
            {% else %}
                <p class="text-muted">Este documento não tem ficheiros anexados.</p>
            {% endif %}

        </div>
    </div>

    <!-- HISTÓRICO -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fa fa-history me-2"></i> Histórico de Tramitação</h5>
        </div>

        <div class="card-body">

            {% if historico is empty %}
                <p class="text-muted">Ainda não existem movimentos neste documento.</p>
            {% else %}

                <div class="timeline">

                    {% for h in historico %}
                        <div class="timeline-item">

                            <div class="timeline-icon bg-primary text-white">
                                {% if h.acao == 'ENCAMINHADO' %}
                                    <i class="fa fa-random"></i>
                                {% elseif h.acao == 'COMENTARIO' %}
                                    <i class="fa fa-comment"></i>
                                {% elseif h.acao == 'ESTADO' %}
                                    <i class="fa fa-flag"></i>
                                {% else %}
                                    <i class="fa fa-circle"></i>
                                {% endif %}
                            </div>

                            <div class="timeline-content">

                                <h6 class="mb-1">
                                    {{ h.utilizador_nome }}
                                    <small class="text-muted">— {{ h.criado_em|date("d/m/Y H:i") }}</small>
                                </h6>

                                <p class="mb-1">
                                    {% if h.acao == 'ENCAMINHADO' %}
                                        Documento encaminhado para <strong>{{ h.area_nome }}</strong>.
                                    {% elseif h.acao == 'COMENTARIO' %}
                                        Comentário adicionado.
                                    {% elseif h.acao == 'ESTADO' %}
                                        Estado alterado para
                                        <span class="badge-estado badge-{{ h.estado_codigo }}">
                                            {{ h.estado_nome|upper }}
                                        </span>.
                                    {% endif %}
                                </p>

                                {% if h.comentario %}
                                    <div class="alert alert-secondary py-2 px-3 mb-2">
                                        {{ h.comentario }}
                                    </div>
                                {% endif %}

                                {% if h.anexos is defined and h.anexos %}
                                    <div class="mt-2">
                                        <strong>Anexos:</strong>
                                        <ul class="list-unstyled ms-2">
                                            {% for a in h.anexos %}
                                                <li>
                                                    <a href="/admin/tramitacao/anexo/{{ h.id }}/{{ a.ficheiro }}"
                                                       target="_blank">
                                                        <i class="fa fa-paperclip me-1"></i> {{ a.nome_original }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}

                            </div>
                        </div>
                    {% endfor %}

                </div>

            {% endif %}

        </div>
    </div>

    <!-- BOTÕES -->
    <div class="d-flex gap-2 mb-4">

        {% if user.hasPermissao('admin.tramitacao.encaminhar') %}
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTramitar">
                <i class="fa fa-random me-1"></i> Encaminhar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.comentar') %}
            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalComentar">
                <i class="fa fa-comment me-1"></i> Comentar
            </button>
        {% endif %}

        {% if user.hasPermissao('admin.tramitacao.estado') %}
            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalEstado">
                <i class="fa fa-flag me-1"></i> Alterar Estado
            </button>
        {% endif %}

    </div>

</div>
{% endblock %}

{% block modals %}
    {% include "@admin/tramitacao/modais.twig" %}

    <!-- MODAL DE PREVIEW INLINE -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Preview do Ficheiro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-0" id="previewContainer"
                     style="min-height: 70vh; display: flex; align-items: center; justify-content: center;">
                    <p class="text-muted">A carregar preview...</p>
                </div>

            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    const previewModal = document.getElementById('previewModal');
    const previewContainer = document.getElementById('previewContainer');

    previewModal.addEventListener('show.bs.modal', function (event) {

        const button = event.relatedTarget;
        const fileUrl = button.getAttribute('data-url');
        const ext = button.getAttribute('data-ext').toLowerCase();

        previewContainer.innerHTML = '<p class="text-muted">A carregar preview...</p>';

        // PDF, TXT, Imagens → abrir diretamente
        if (['pdf','txt','jpg','jpeg','png','gif','webp'].includes(ext)) {

            if (['jpg','jpeg','png','gif','webp'].includes(ext)) {
                previewContainer.innerHTML =
                    `<img src="${fileUrl}" class="img-fluid" style="max-height: 70vh;">`;
            } else {
                previewContainer.innerHTML =
                    `<iframe src="${fileUrl}" style="width:100%; height:70vh;" frameborder="0"></iframe>`;
            }

        }

        // Word / Excel → Office Viewer
        else if (['doc','docx','xls','xlsx'].includes(ext)) {

            const encoded = encodeURIComponent(window.location.origin + fileUrl);

            previewContainer.innerHTML =
                `<iframe src="https://view.officeapps.live.com/op/view.aspx?src=${encoded}"
                         style="width:100%; height:70vh;" frameborder="0"></iframe>`;
        }

        else {
            previewContainer.innerHTML =
                `<p class="text-danger">Preview não disponível para este tipo de ficheiro.</p>`;
        }
    });

});
</script>
{% endblock %}
