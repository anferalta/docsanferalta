{# ============================================================
   ABA: TRAMITAÇÃO DO DOCUMENTO
============================================================ #}

<div class="tab-pane fade show active" id="tab-tramitacao">

    {# ============================================================
       ANEXOS DO DOCUMENTO (documento_ficheiros)
    ============================================================ #}

    {% if ficheiros and ficheiros|length > 0 %}
        <div class="mb-4">
            <h5 class="fw-bold">
                <i class="fa fa-paperclip me-1"></i> Anexos do Documento
            </h5>

            <ul class="list-group mt-2">
                {% for f in ficheiros %}
                    {% set ext = f.ficheiro_original|lower|split('.')|last %}
                    {% set url = "/admin/documentos/anexo/abrir/" ~ f.id %}

                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            {% if ext == 'pdf' %}
                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                            {% elseif ext in ['doc','docx'] %}
                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                            {% elseif ext in ['xls','xlsx'] %}
                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                            {% elseif ext in ['zip','rar'] %}
                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                            {% else %}
                                <i class="fa fa-file fa-lg me-2"></i>
                            {% endif %}

                            <span>{{ f.ficheiro_original ?: f.ficheiro }}</span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="button"
        			class="btn btn-sm btn-outline-secondary btn-preview-inline"
        			data-bs-toggle="modal"
        			data-bs-target="#previewModal"
        			data-url="{{ url }}"
        			data-ext="{{ ext }}">
    				<i class="fa fa-eye me-1"></i> Preview
			    </button>

                            <a href="{{ url }}"
                               target="_blank"
                               class="btn btn-sm btn-primary">
                                <i class="fa fa-download me-1"></i> Abrir
                            </a>

                        </div>

                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ============================================================
       ANEXOS DA TRAMITAÇÃO (lista consolidada)
============================================================ #}

    {% set anexos_tramitacao = [] %}

    {% for h in historico %}
        {% if h.anexos and h.anexos|length > 0 %}
            {% for a in h.anexos %}
                {% set anexos_tramitacao = anexos_tramitacao|merge([a]) %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if anexos_tramitacao|length > 0 %}
        <div class="mb-4">
            <h5 class="fw-bold">
                <i class="fa fa-paperclip me-1"></i> Anexos da Tramitação
            </h5>

            <ul class="list-group mt-2">
                {% for a in anexos_tramitacao %}
                    {% set ext = a.ficheiro_original|lower|split('.')|last %}
                    {% set url = "/admin/tramitacao/anexo/abrir/" ~ a.id %}

                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            {% if ext == 'pdf' %}
                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                            {% elseif ext in ['doc','docx'] %}
                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                            {% elseif ext in ['xls','xlsx'] %}
                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                            {% elseif ext in ['zip','rar'] %}
                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                            {% else %}
                                <i class="fa fa-file fa-lg me-2"></i>
                            {% endif %}

                            <span>{{ a.ficheiro_original ?: a.ficheiro }}</span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary btn-preview-inline"
                                    data-bs-toggle="modal"
                                    data-bs-target="#previewModal"
                                    data-url="{{ url }}"
                                    data-mime="{{ a.mime_type }}">
                                <i class="fa fa-eye me-1"></i> Preview
                            </button>

                            <a href="{{ url }}"
                               target="_blank"
                               class="btn btn-sm btn-primary">
                                <i class="fa fa-download me-1"></i> Abrir
                            </a>

                        </div>

                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ============================================================
       HISTÓRICO DA TRAMITAÇÃO
    ============================================================ #}

    <h5 class="fw-bold mt-4">
        <i class="fa fa-random me-1"></i> Histórico de Tramitação
    </h5>

    <ul class="timeline mt-3">

        {% for h in historico %}
            <li class="timeline-item">

                <div class="timeline-marker"></div>

                <div class="timeline-content">

                    <h6 class="fw-bold mb-1">
                        {{ h.acao }} — {{ h.criado_em|date("d/m/Y H:i") }}
                    </h6>

                    <p class="mb-2">
                        <strong>Área:</strong> {{ h.area ? h.area.nome : '—' }}<br>
                        <strong>Utilizador:</strong> {{ h.utilizador ? h.utilizador.nome : '—' }}
                    </p>

                    {% if h.comentario %}
                        <p class="mb-2">
                            <strong>Comentário:</strong><br>
                            {{ h.comentario }}
                        </p>
                    {% endif %}

                    {% if h.anexos and h.anexos|length > 0 %}
                        <div class="mt-3">
                            <strong><i class="fa fa-paperclip me-1"></i> Anexos da ação:</strong>

                            <ul class="list-group mt-2">

                                {% for a in h.anexos %}
                                    {% set ext = a.ficheiro_original|lower|split('.')|last %}
                                    {% set url = "/admin/tramitacao/anexo/abrir/" ~ a.id %}

                                    <li class="list-group-item d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">

                                            {% if ext == 'pdf' %}
                                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                                            {% elseif ext in ['doc','docx'] %}
                                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                                            {% elseif ext in ['xls','xlsx'] %}
                                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                                            {% elseif ext in ['zip','rar'] %}
                                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                                            {% else %}
                                                <i class="fa fa-file fa-lg me-2"></i>
                                            {% endif %}

                                            <span>{{ a.ficheiro_original ?: a.ficheiro }}</span>
                                        </div>

                                        <div class="d-flex gap-2">

                                            {% set ext = f.ficheiro_original|lower|split('.')|last %}

					    <button type="button"
  					      class="btn btn-sm btn-outline-secondary btn-preview-inline"
    					      data-bs-toggle="modal"
        				      data-bs-target="#previewModal"
        				      data-url="{{ url }}"
        				      data-ext="{{ ext }}">
    						<i class="fa fa-eye me-1"></i> Preview
					    </button>

                                            <a href="{{ url }}"
                                               target="_blank"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa fa-download me-1"></i> Abrir
                                            </a>

                                        </div>

                                    </li>
                                {% endfor %}

                            </ul>
                        </div>
                    {% endif %}

                </div>
            </li>
        {% endfor %}

    </ul>

</div>

{# ============================================================
   MODAL DE PREVIEW INLINE
============================================================ #}

<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-eye me-1"></i> Preview
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <iframe id="previewFrame"
                        src=""
                        style="width:100%; height:80vh; border:0;"></iframe>
            </div>

        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.btn-preview-inline').forEach(btn => {

        btn.addEventListener('click', function () {

            const url  = btn.getAttribute('data-url');
            const mime = btn.getAttribute('data-mime') || '';
            const frame = document.getElementById('previewFrame');

            frame.src = "";

            let ext = "";

            if (mime.includes('pdf')) ext = 'pdf';
            else if (mime.includes('msword')) ext = 'doc';
            else if (mime.includes('word')) ext = 'docx';
            else if (mime.includes('excel')) ext = 'xlsx';
            else if (mime.includes('spreadsheet')) ext = 'xls';
            else if (mime.includes('powerpoint')) ext = 'pptx';
            else if (mime.includes('presentation')) ext = 'ppt';
            else if (mime.includes('text')) ext = 'txt';
            else if (mime.includes('image')) ext = 'jpg';

            if (ext === 'pdf') {
                frame.src = url;
                return;
            }

            if (['doc','docx','xls','xlsx','ppt','pptx'].includes(ext)) {
                frame.src = "https://view.officeapps.live.com/op/view.aspx?src=" + encodeURIComponent(url);
                return;
            }

            if (['jpg','jpeg','png','gif','webp'].includes(ext)) {
                frame.src = url;
                return;
            }

            if (ext === 'txt') {
                frame.src = url;
                return;
            }

            frame.src = url;
        });
    });

});
</script>
