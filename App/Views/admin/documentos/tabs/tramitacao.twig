{# ============================================================
   ABA: TRAMITAÇÃO DO DOCUMENTO
============================================================ #}

<div class="tab-pane fade show active" id="tab-tramitacao">

    {# ============================================================
       ANEXOS DO DOCUMENTO (documento_ficheiros)
    ============================================================ #}

    {% if ficheiros and ficheiros|length > 0 %}
        <div class="mb-4">
            <h5 class="fw-bold">
                <i class="fa fa-paperclip me-1"></i> Anexos do Documento
            </h5>

            <ul class="list-group mt-2">
                {% for f in ficheiros %}
                    {% set nomeAnexo = f.ficheiro_original|default(f.ficheiro|default('')) %}
                    {% set ext = nomeAnexo|lower|split('.')|last %}
                    {% set url = "/admin/documentos/anexo/abrir/" ~ f.id %}

                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            {% if ext == 'pdf' %}
                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                            {% elseif ext in ['doc','docx'] %}
                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                            {% elseif ext in ['xls','xlsx'] %}
                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                            {% elseif ext in ['zip','rar'] %}
                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                            {% else %}
                                <i class="fa fa-file fa-lg me-2"></i>
                            {% endif %}

                            <span>{{ f.ficheiro_original ?: f.ficheiro }}</span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="button"
        			class="btn btn-sm btn-outline-secondary btn-preview-inline"
        			data-bs-toggle="modal"
        			data-bs-target="#previewModal"
        			data-url="{{ url }}"
				data-ext="{{ ext }}"
                                data-preview-url="{% if ext in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/documentos/preview-pdf/{{ f.id }}{% endif %}">
    				<i class="fa fa-eye me-1"></i> Preview
			    </button>

                            <a href="/admin/documentos/preview/{{ f.id }}"
                               target="_blank"
                               class="btn btn-sm btn-primary">
                                <i class="fa fa-external-link-alt me-1"></i> Abrir
                            </a>

                        </div>

                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ============================================================
       ANEXOS DA TRAMITAÇÃO (lista consolidada)
============================================================ #}

    {% set anexos_tramitacao = [] %}

    {% for h in historico %}
        {% if h.anexos and h.anexos|length > 0 %}
            {% for a in h.anexos %}
                {% set anexos_tramitacao = anexos_tramitacao|merge([a]) %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if anexos_tramitacao|length > 0 %}
        <div class="mb-4">
            <h5 class="fw-bold">
                <i class="fa fa-paperclip me-1"></i> Anexos da Tramitação
            </h5>

            <ul class="list-group mt-2">
                {% for a in anexos_tramitacao %}
                    {% set nomeAnexo = a.ficheiro_original|default(a.ficheiro|default('')) %}
                    {% set ext = nomeAnexo|lower|split('.')|last %}
                    {% set url = "/admin/tramitacao/anexo/abrir/" ~ a.id %}
                    {% set abrirUrl = url %}
                    {% if ext in ['doc','docx','xls','xlsx','ppt','pptx'] %}
                        {% set abrirUrl = "/admin/tramitacao/anexo/preview-pdf/" ~ a.id %}
                    {% endif %}

                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center">

                            {% if ext == 'pdf' %}
                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                            {% elseif ext in ['doc','docx'] %}
                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                            {% elseif ext in ['xls','xlsx'] %}
                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                            {% elseif ext in ['zip','rar'] %}
                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                            {% else %}
                                <i class="fa fa-file fa-lg me-2"></i>
                            {% endif %}

                            <span>{{ a.ficheiro_original ?: a.ficheiro }}</span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary btn-preview-inline"
                                    data-bs-toggle="modal"
                                    data-bs-target="#previewModal"
                                    data-url="{{ url }}"
                                    data-ext="{{ ext }}"
                                    data-preview-url="{% if ext in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/tramitacao/anexo/preview-pdf/{{ a.id }}{% endif %}"
                                    data-mime="{{ a.mime_type }}">
                                <i class="fa fa-eye me-1"></i> Preview
                            </button>

                            <a href="{{ abrirUrl }}"
                               target="_blank"
                               class="btn btn-sm btn-primary">
                                <i class="fa fa-external-link-alt me-1"></i> Abrir
                            </a>

                        </div>

                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ============================================================
       HISTÓRICO DA TRAMITAÇÃO
    ============================================================ #}

    <h5 class="fw-bold mt-4">
        <i class="fa fa-random me-1"></i> Histórico de Tramitação
    </h5>

    <ul class="timeline mt-3">

        {% for h in historico %}
            <li class="timeline-item">

                <div class="timeline-marker"></div>

                <div class="timeline-content">

                    <h6 class="fw-bold mb-1">
                        {% if h.acao == 'ENCAMINHADO' %}
                            Encaminhado{% if h.area is defined and h.area %} para {{ h.area.nome }}{% elseif h.area_nome is defined and h.area_nome %} para {{ h.area_nome }}{% endif %}
                        {% elseif h.acao == 'ESTADO' %}
                            Estado alterado para {{ h.estado_nome|default(h.estado|default('indefinido')|replace({'_':' '})|upper) }}
                        {% elseif h.acao == 'COMENTARIO' %}
                            Comentário
                        {% elseif h.acao == 'ARQUIVADO' %}
                            Documento arquivado
                        {% elseif h.acao == 'RECUPERAR' %}
                            Documento recuperado
                        {% else %}
                            {{ h.acao|replace({'_':' '})|capitalize }}
                        {% endif %}
                    </h6>
                    <small class="text-muted d-block mb-2">{{ h.criado_em|date("d/m/Y H:i") }}</small>

                    <p class="mb-2">
                        <strong>Área:</strong>
                        {% if h.area is defined and h.area %}
                            {{ h.area.nome }}
                        {% elseif h.area_nome is defined and h.area_nome %}
                            {{ h.area_nome }}
                        {% else %}
                            —
                        {% endif %}<br>
                        <strong>Utilizador:</strong>
                        {% if h.utilizador is defined and h.utilizador %}
                            {{ h.utilizador.nome }}
                        {% elseif h.utilizador_nome is defined and h.utilizador_nome %}
                            {{ h.utilizador_nome }}
                        {% else %}
                            —
                        {% endif %}
                    </p>

                    {% if h.comentario %}
                        <p class="mb-2">
                            <strong>Comentário:</strong><br>
                            {{ h.comentario }}
                        </p>
                    {% endif %}

                    {% if h.anexos and h.anexos|length > 0 %}
                        <div class="mt-3">
                            <strong><i class="fa fa-paperclip me-1"></i> Anexos da ação:</strong>

                            <ul class="list-group mt-2">

                                {% for a in h.anexos %}
                                    {% set nomeAnexo = a.ficheiro_original|default(a.ficheiro|default('')) %}
                                    {% set ext = nomeAnexo|lower|split('.')|last %}
                                    {% set url = "/admin/tramitacao/anexo/abrir/" ~ a.id %}
                                    {% set abrirUrl = url %}
                                    {% if ext in ['doc','docx','xls','xlsx','ppt','pptx'] %}
                                        {% set abrirUrl = "/admin/tramitacao/anexo/preview-pdf/" ~ a.id %}
                                    {% endif %}

                                    <li class="list-group-item d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">

                                            {% if ext == 'pdf' %}
                                                <i class="fa fa-file-pdf text-danger fa-lg me-2"></i>
                                            {% elseif ext in ['jpg','jpeg','png','gif','webp'] %}
                                                <i class="fa fa-file-image text-primary fa-lg me-2"></i>
                                            {% elseif ext in ['doc','docx'] %}
                                                <i class="fa fa-file-word text-info fa-lg me-2"></i>
                                            {% elseif ext in ['xls','xlsx'] %}
                                                <i class="fa fa-file-excel text-success fa-lg me-2"></i>
                                            {% elseif ext in ['zip','rar'] %}
                                                <i class="fa fa-file-archive text-warning fa-lg me-2"></i>
                                            {% else %}
                                                <i class="fa fa-file fa-lg me-2"></i>
                                            {% endif %}

                                            <span>{{ a.ficheiro_original ?: a.ficheiro }}</span>
                                        </div>

                                        <div class="d-flex gap-2">

					    <button type="button"
  					      class="btn btn-sm btn-outline-secondary btn-preview-inline"
    					      data-bs-toggle="modal"
        				      data-bs-target="#previewModal"
        				      data-url="{{ url }}"
		      data-ext="{{ ext }}"
                                              data-preview-url="{% if ext in ['doc','docx','xls','xlsx','ppt','pptx'] %}/admin/tramitacao/anexo/preview-pdf/{{ a.id }}{% endif %}"
                                              data-mime="{{ a.mime_type }}">
    						<i class="fa fa-eye me-1"></i> Preview
					    </button>

                                            <a href="{{ abrirUrl }}"
                                               target="_blank"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa fa-external-link-alt me-1"></i> Abrir
                                            </a>

                                        </div>

                                    </li>
                                {% endfor %}

                            </ul>
                        </div>
                    {% endif %}

                </div>
            </li>
        {% endfor %}

    </ul>

</div>

