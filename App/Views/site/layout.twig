<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block head_before %}{% endblock %}

    <title>{% block title %}Gestão Documental{% endblock %}</title>

    <!-- CSS principal do site -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/site.css">

    {% block head %}{% endblock %}
</head>

<body class="d-flex flex-column min-vh-100">

    {# SIDEBAR APENAS PARA UTILIZADORES AUTENTICADOS #}
    {% if auth.user %}
        {% include 'site/partials/sidebar_user.twig' %}
    {% endif %}

    {# CONTEÚDO PRINCIPAL #}
    <main class="container-fluid my-4"
          style="{% if auth.user %}margin-left:240px{% endif %};">

        {# FLASH MESSAGES #}
        {% include "@site/partials/_flash.twig" %}

        {# CONTEÚDO DAS PÁGINAS #}
        {% block content %}{% endblock %}
    </main>

    {# FOOTER — TAMBÉM CONDICIONADO AO SIDEBAR #}
    <footer class="bg-light border-top py-3 mt-auto"
            style="{% if auth.user %}margin-left:240px{% endif %};">
        <div class="container text-center text-muted">
            &copy; {{ "now"|date("Y") }} Gestão Documental — Todos os direitos reservados
        </div>
    </footer>

    {% block scripts_before %}{% endblock %}

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    {% block scripts %}{% endblock %}
</body>

</html>
