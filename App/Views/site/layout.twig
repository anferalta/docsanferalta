<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block head_before %}{% endblock %}

    <title>{% block title %}Gestão Documental — ANFERALTA{% endblock %}</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    {% if auth.user %}
        <link rel="stylesheet" href="/assets/css/admin.css">
    {% endif %}

    <link rel="stylesheet" href="/assets/css/site.css">

    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    {% block head %}{% endblock %}
</head>

<body class="{% if auth.user %}admin-wrapper{% else %}d-flex flex-column min-vh-100{% endif %}">

    {% if auth.user %}
        {% include "@site/partials/sidebar_user.twig" %}
    {% endif %}

    <div class="{% if auth.user %}content-area{% else %}container my-4{% endif %}">

        {% if auth.user %}
        <div class="topbar d-flex align-items-center justify-content-between px-3">

            <!-- Botão de menu móvel -->
            <button class="btn-toggle-sidebar d-md-none">
                <i class="bi bi-list" style="font-size:1.5rem;"></i>
            </button>

            <div class="d-flex align-items-center gap-3 ms-auto">

                <button class="btn-notification">
                    <i class="bi bi-bell"></i>
                    <span class="notif-badge">3</span>
                </button>

            </div>

        </div>
        {% endif %}

        {% include "@site/partials/_flash.twig" %}

        <main class="{% if auth.user %}page-content{% endif %}">
            {% block content %}{% endblock %}
        </main>

        <footer class="bg-light border-top py-3 mt-auto">
            <div class="container text-center text-muted">
                &copy; {{ "now"|date("Y") }} ANFERALTA Empreendimentos, Lda — Gestão Documental
            </div>
        </footer>

    </div>

    {% block scripts_before %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    {% block scripts %}{% endblock %}

    {% if auth.user %}
    <script>
    (function () {
        const btn = document.querySelector('.btn-toggle-sidebar');
        const body = document.body;

        if (btn) {
            btn.addEventListener('click', function () {
                body.classList.toggle('sidebar-open');
            });
        }
    })();
    </script>
    {% endif %}

</body>
</html>
