<div class="flash-container">

    {% if erro %}
        <div class="alert alert-danger">

            {% if erro == 'titulo' %}O título é obrigatório.
            {% elseif erro == 'tipo' %}Selecione o tipo de documento.
            {% elseif erro == 'ficheiros' %}Selecione pelo menos um ficheiro.
            {% elseif erro == 'extensao' %}Extensão de ficheiro inválida.
            {% elseif erro == 'tamanho' %}Ficheiro demasiado grande.
            {% elseif erro == 'ficheiro_duplicado' %}Já existe um ficheiro com esse nome.

            {% else %}
                {{ erro }}
            {% endif %}

        </div>
    {% endif %}

    {% if sucesso %}
        <div class="alert alert-success">
            {{ sucesso }}
        </div>
    {% endif %}

</div>
