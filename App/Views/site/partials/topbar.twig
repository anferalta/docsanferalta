<header class="navbar navbar-light bg-white shadow-sm px-3 d-flex justify-content-between">

    <!-- LEFT: Sidebar Toggle -->
    <button class="btn btn-sm btn-outline-primary me-3 sidebar-toggle">
        <i class="bi bi-list"></i>
    </button>

    <!-- RIGHT: Notifications + User -->
    <div class="d-flex align-items-center">

        {# ============================
           NOTIFICAÇÕES
        ============================ #}

        {% set notificacoes = notificacoes_unread ?? [] %}

        <div class="dropdown me-3">

            <button class="btn btn-light position-relative" data-bs-toggle="dropdown">
                <i class="bi bi-bell"></i>

                {% if notificacoes|length > 0 %}
                    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                        {{ notificacoes|length }}
                    </span>
                {% endif %}
            </button>

            <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg">

                {% if notificacoes %}
                    <div class="list-group list-group-flush">

                        {% for n in notificacoes %}
                            <a href="{{ url('/admin/notificacoes/ver/' ~ n.id) }}"
                               class="list-group-item">
                                <div class="fw-semibold">{{ n.titulo }}</div>
                                <div class="small text-muted">{{ n.mensagem }}</div>
                                <div class="small text-secondary">{{ n.criado_em }}</div>
                            </a>
                        {% endfor %}

                    </div>

                    <a href="{{ admin_url('notificacoes') }}"
                       class="dropdown-item text-center fw-semibold text-primary py-2">
                        Ver todas
                    </a>

                {% else %}
                    <div class="p-3 text-center text-muted small">
                        Sem novas notificações
                    </div>
                {% endif %}

            </div>
        </div>

        {# ============================
           USER DROPDOWN
        ============================ #}

        <div class="dropdown">

            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle"
               data-bs-toggle="dropdown">

                <img src="/assets/img/avatar.png"
                     class="rounded-circle me-2"
                     width="32" height="32">

                <span class="fw-semibold">{{ usuario_nome }}</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                <li>
                    <a class="dropdown-item" href="/admin/perfil">
                        <i class="bi bi-person me-2"></i> Meu Perfil
                    </a>
                </li>

                <li><hr class="dropdown-divider"></li>

                <li>
                    <form method="post" action="{{ url('/logout') }}">
                        <input type="hidden" name="csrf" value="{{ csrf }}">
                        <button class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i> Sair
                        </button>
                    </form>
                </li>

            </ul>
        </div>

    </div>

</header>
