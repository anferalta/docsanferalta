<div class="mb-3">

    <label for="{{ name }}" class="form-label">
        {{ label }}
    </label>

    <input
        type="{{ type|default('text') }}"
        id="{{ name }}"
        name="{{ name }}"
        class="form-control {% if errors[name] %}is-invalid{% endif %}"
        value="{{ value|default('')|e }}"
        placeholder="{{ placeholder|default('') }}"
    >

    {% if errors[name] %}
        <div class="invalid-feedback">
            {{ errors[name] }}
        </div>
    {% endif %}

</div>
