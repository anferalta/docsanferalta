{% extends "@site/layout.twig" %}

{% block title %}Editar Documento{% endblock %}

{% block content %}

<h1 class="mb-4">Editar Documento</h1>

<div class="card shadow-sm border-0 p-4">

    <form action="{{ url('/documentos/update/' ~ doc.id) }}" method="post">

        <input type="hidden" name="csrf" value="{{ csrf }}">

        <div class="mb-3">
            <label for="titulo" class="form-label">Título</label>
            <input
                type="text"
                id="titulo"
                name="titulo"
                class="form-control"
                value="{{ doc.titulo|e }}"
                required
            >
        </div>

        <div class="mb-3">
            <label for="descricao" class="form-label">Descrição</label>
            <textarea
                id="descricao"
                name="descricao"
                class="form-control"
                rows="4"
            >{{ doc.descricao|e }}</textarea>
        </div>

        <div class="mb-3">
            <label for="estado" class="form-label">Estado</label>
            <select id="estado" name="estado" class="form-select">
                <option value="ativo"   {% if doc.estado == 'ativo' %}selected{% endif %}>Ativo</option>
                <option value="inativo" {% if doc.estado == 'inativo' %}selected{% endif %}>Inativo</option>
            </select>
        </div>

        {% if errors %}
            <div class="alert alert-danger">
                <ul class="mb-0">
                    {% for e in errors %}
                        <li>{{ e }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <button class="btn btn-primary mt-3">Atualizar</button>

    </form>

</div>

{% endblock %}
