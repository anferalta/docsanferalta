<div class="p-3">
    <h5 class="mb-3">{{ nome }}</h5>

    {% if mime starts with 'image/' %}
        <img src="{{ caminho }}" class="img-fluid rounded border">

    {% elseif mime == 'application/pdf' %}
        <iframe src="{{ caminho }}" width="100%" height="600px" class="border rounded"></iframe>

    {% elseif mime starts with 'text/' %}
        <iframe src="{{ caminho }}" width="100%" height="600px" class="border rounded"></iframe>

    {% elseif mime == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' %}
        <iframe 
            src="https://view.officeapps.live.com/op/view.aspx?src={{ caminho|url_encode }}" 
            width="100%" height="600px" 
            class="border rounded">
        </iframe>

    {% else %}
        <p class="text-muted">Este tipo de ficheiro não pode ser pré-visualizado.</p>
        <a href="{{ caminho }}" class="btn btn-primary" download>Download</a>
    {% endif %}
</div>
