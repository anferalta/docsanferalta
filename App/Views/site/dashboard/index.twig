{% extends "@site/layout.twig" %}

{% block title %}O Meu Dashboard{% endblock %}

{% block content %}

    <h2 class="mb-4">O Meu Dashboard</h2>

    <div class="row g-4">

        {% set cards = [
            { title: 'Os Meus Documentos', value: total, color: 'primary' },
            { title: 'Novos', value: novo, color: 'secondary' },
            { title: 'Pendentes', value: pendentes, color: 'warning' },
            { title: 'Em Análise', value: analise, color: 'info' },
            { title: 'Em Tramitação', value: emTramitacao, color: 'secondary' },
            { title: 'Concluídos', value: concluidos, color: 'success' },
            { title: 'Arquivados', value: arquivados, color: 'dark' },
            { title: 'Devolvidos', value: devolvidos, color: 'danger' },
        ] %}

        {% for c in cards %}
            <div class="col-md-4 col-lg-3">
                <div class="p-3 rounded shadow-sm bg-{{ c.color }} bg-opacity-10 text-center">
                    <h6 class="mb-2">{{ c.title }}</h6>
                    <h3 class="text-{{ c.color }}">{{ c.value }}</h3>
                </div>
            </div>
        {% endfor %}

    </div>

{% endblock %}
