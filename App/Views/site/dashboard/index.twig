{% extends "@site/layout.twig" %}
{% block title %}O Meu Dashboard{% endblock %}

{% block content %}

<h2 class="mb-4" style="font-family: Montserrat; color: var(--brand-dark);">
    O Meu Dashboard
</h2>

<div class="row g-4">

    {% set cards = [
        { title: 'Os Meus Documentos', value: total, icon: 'bi-folder', color: 'var(--brand-primary)' },
        { title: 'Novos', value: novo, icon: 'bi-star', color: '#6f42c1' },
        { title: 'Pendentes', value: pendentes, icon: 'bi-hourglass-split', color: '#ffc107' },
        { title: 'Em Análise', value: analise, icon: 'bi-search', color: '#17a2b8' },
        { title: 'Em Tramitação', value: emTramitacao, icon: 'bi-arrow-repeat', color: '#6c757d' },
        { title: 'Concluídos', value: concluidos, icon: 'bi-check-circle', color: '#198754' },
        { title: 'Arquivados', value: arquivados, icon: 'bi-archive', color: '#343a40' },
        { title: 'Devolvidos', value: devolvidos, icon: 'bi-x-circle', color: '#dc3545' },
    ] %}

    {% for c in cards %}
        <div class="col-md-4 col-lg-3">
            <div class="p-4 rounded shadow-sm text-center"
                 style="
                    background: #fff;
                    border: 1px solid #e1e4e8;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
                 ">

                <div class="mb-2">
                    <i class="bi {{ c.icon }}"
                       style="font-size: 1.8rem; color: {{ c.color }};"></i>
                </div>

                <h6 class="mb-1" style="font-family: Inter; color: var(--brand-dark);">
                    {{ c.title }}
                </h6>

                <h3 class="fw-bold" style="color: {{ c.color }}; font-family: Montserrat;">
                    {{ c.value }}
                </h3>

            </div>
        </div>
    {% endfor %}

</div>

{% endblock %}
