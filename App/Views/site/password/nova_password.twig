{% extends "@site/layout.twig" %}

{% block title %}Nova Password{% endblock %}

{% block content %}
<div class="card mx-auto shadow-sm border-0 p-4" style="max-width:480px;">

    <h1 class="text-center mb-4">Criar nova password</h1>

    <form method="post" action="/reset-password/guardar/{{ token }}">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="token" value="{{ token }}">

        <div class="mb-3">
            <label for="password" class="form-label">Nova password</label>
            <input type="password" id="password" name="password" class="form-control" required minlength="6">
        </div>

        <div class="mb-3">
            <label for="password_confirm" class="form-label">Confirmar password</label>
            <input type="password" id="password_confirm" name="password_confirm" class="form-control" required minlength="6">
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Guardar nova password
        </button>
    </form>

    <p class="mt-3 text-center">
        <a href="/login">Voltar ao login</a>
    </p>

</div>
{% endblock %}
