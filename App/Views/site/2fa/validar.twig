{% extends "@site/layout.twig" %}

{% block content %}

<h2 class="mb-4">Validar Autenticação 2FA</h2>

<p>Introduza o código gerado pela sua aplicação de autenticação.</p>

<form method="post" action="/2fa/validar" class="mt-4">

    <input type="hidden" name="csrf" value="{{ csrf }}">

    <div class="mb-3">
        <label class="form-label">Código 2FA:</label>
        <input type="text" name="codigo" class="form-control" required>
    </div>

    <button type="submit" class="btn btn-primary">
        Validar
    </button>
</form>

{% endblock %}
