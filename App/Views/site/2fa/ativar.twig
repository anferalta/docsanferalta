{% extends "@site/layout.twig" %}

{% block content %}

<h2 class="mb-4">Ativar Autenticação de Dois Fatores</h2>

<p>Digitalize o QR Code abaixo com o Google Authenticator:</p>

<div class="text-center my-4">
    <img src="{{ qrCode }}" alt="QR Code 2FA" class="img-fluid border p-3">
</div>

<p>Ou introduza este código manualmente:</p>

<pre class="bg-light p-3 border">{{ secret }}</pre>

<form method="post" action="/2fa/confirmar" class="mt-4">

    <input type="hidden" name="csrf" value="{{ csrf }}">

    <div class="mb-3">
        <label class="form-label">Código de verificação:</label>
        <input type="text" name="codigo" class="form-control" required>
    </div>

    <button type="submit" class="btn btn-primary">
        Confirmar
    </button>
</form>

{% endblock %}
