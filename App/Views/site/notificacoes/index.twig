{% extends "@site/layout.twig" %}

{% block title %}Notificações{% endblock %}

{% block content %}

<h1 class="mb-4">Notificações</h1>

<div class="card shadow-sm border-0 p-4">

    <div class="mb-3">
        <a href="{{ url('/notificacoes/marcar-todas') }}" class="btn btn-sm btn-primary">
            Marcar todas como lidas
        </a>
    </div>

    {% if notificacoes is empty %}

        <div class="alert alert-info mb-0">
            Não tens notificações.
        </div>

    {% else %}

        <div class="list-group">

            {% for n in notificacoes %}

                <div class="list-group-item">

                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <strong>{{ n.titulo }}</strong>

                        <div class="d-flex gap-2">

                            {% if not n.lida %}
                                <a href="{{ url('/notificacoes/marcar/' ~ n.id) }}" class="btn btn-sm btn-success">
                                    Marcar como lida
                                </a>
                            {% endif %}

                            <a href="{{ url('/notificacoes/apagar/' ~ n.id) }}"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Apagar esta notificação?')">
                                Apagar
                            </a>

                        </div>
                    </div>

                    <div class="text-muted mb-2">
                        {{ n.mensagem }}
                    </div>

                    <small class="text-muted">
                        {{ n.criado_em }}
                        {% if n.lida %}
                            • Lida em {{ n.lida_em }}
                        {% endif %}
                    </small>

                </div>

            {% endfor %}

        </div>

    {% endif %}

</div>

{% endblock %}
