<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dashboard{% endblock %}</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <link rel="stylesheet" href="/assets/css/admin.css">

    <style>
        body {
            background: #f5f6fa;
            margin: 0;
            padding: 0;
        }

        .sidebar-user {
            width: 240px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #ffffff;
            border-right: 1px solid #ddd;
            padding: 20px;
            overflow-y: auto;
        }

        .content-area {
            margin-left: 240px;
            padding: 30px;
            min-height: 100vh;
        }

        .nav-link {
            color: #333;
            font-weight: 500;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .nav-link:hover {
            background: #f0f0f0;
        }

        .nav-link.active {
            background: #0d6efd;
            color: white !important;
        }
    </style>
</head>

<body>

    <div class="sidebar-user">
        {% include "partials/sidebar_user.twig" %}
    </div>

    <div class="content-area">

        <!-- MENSAGENS (PADRÃO DO PROJETO) -->
        {% if sucesso %}
            <div class="alert alert-success alert-dismissible fade show mb-3">
                <i class="fa fa-check-circle me-2"></i>
                Ficheiro(s) inseridos com sucesso.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        {% if erro == 'ficheiros' %}
            <div class="alert alert-danger alert-dismissible fade show mb-3">
                <i class="fa fa-exclamation-circle me-2"></i>
                Selecione pelo menos um ficheiro.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        {% if erro == 'extensao' %}
            <div class="alert alert-danger alert-dismissible fade show mb-3">
                <i class="fa fa-ban me-2"></i>
                Tipo de ficheiro não permitido.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        {% if erro == 'tamanho' %}
            <div class="alert alert-danger alert-dismissible fade show mb-3">
                <i class="fa fa-exclamation-triangle me-2"></i>
                O ficheiro excede o tamanho máximo permitido (20MB).
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        {% if erro == 'ficheiro_duplicado' %}
            <div class="alert alert-warning alert-dismissible fade show mb-3">
                <i class="fa fa-clone me-2"></i>
                Já enviou este ficheiro anteriormente. Não é permitido duplicar anexos.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </div>

    {% block scripts %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
