<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Admin{% endblock %}</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- CSS do sistema -->
    <link rel="stylesheet" href="/assets/css/logs.css">
    <link rel="stylesheet" href="/assets/css/admin.css?v=20261108-dashboard-menu-3">
    <link rel="stylesheet" href="/assets/css/badges.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Inter:wght@300;400;500;600&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <style>
    .sidebar-overlay { display: none; border: 0; }
    .btn-toggle-sidebar { display: none; flex-shrink: 0; }
    @media (max-width: 992px) {
        #sidebar { position: fixed; top: 0; left: -240px; width: 240px; height: 100vh; overflow-y: auto; z-index: 3000; }
        body.sidebar-open #sidebar { left: 0; }
        .content-area { margin-left: 0 !important; min-width: 0; }
        .btn-toggle-sidebar { display: inline-flex !important; }
        body.sidebar-open .sidebar-overlay { display: block; position: fixed; inset: 0; width: 100%; height: 100%; background: rgba(0,0,0,.4); z-index: 2000; }
        body.sidebar-open { overflow: hidden; }
    }
    </style>
    {% block head %}{% endblock %}
</head>

<body>
<a href="#conteudo_principal" class="visually-hidden-focusable">Saltar para o conteúdo</a>

<div class="admin-wrapper d-flex">

    <!-- SIDEBAR -->
    <aside id="sidebar-wrapper">
        <div id="sidebar" class="sidebar">

            <div class="logo">
                <a href="/admin" aria-label="Painel de administração Anferalta">
                    <img src="/assets/logo/anferalta-branco.svg" alt="Anferalta" width="220" height="50" style="display:block;width:100%;max-width:220px;height:auto">
                </a>
            </div>

            <nav class="sidebar-nav" aria-label="Menu principal"><ul>
            {% for item in menuAdmin %}
                {% if item.header is defined %}<li class="menu-header">{{ item.header }}</li>
                {% else %}
                <li class="menu-item {{ item.ativo?'active':'' }} {{ item.aberto|default(false)?'open':'' }}">
                    <a href="{{ item.url }}" class="menu-link {{ item.principal|default(false)?'main':'' }}" {% if item.ativo %}aria-current="page"{% endif %}>
                        {% if item.icone is defined %}<i class="bi {{ item.icone }}" aria-hidden="true"></i>{% endif %}<span>{{ item.titulo }}</span>
                        {% if item.badge is defined and item.badge>0 %}<span class="badge">{{ item.badge }}</span>{% endif %}
                    </a>
                    {% if item.sub is defined and item.sub %}<ul class="submenu-list">{% for sub in item.sub %}{% if sub.header is not defined %}<li class="submenu-item {{ sub.ativo?'active':'' }}"><a href="{{ sub.url }}" class="submenu-link" {% if sub.ativo %}aria-current="page"{% endif %}>{{ sub.titulo }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}
                </li>
                {% endif %}
            {% endfor %}
            </ul></nav>

        </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="content-area flex-grow-1">

        <!-- TOPBAR -->
        <header class="topbar d-flex align-items-center justify-content-between px-4">

            <!-- Botão hambúrguer (mobile) -->
            <button id="btnToggleSidebar" data-sidebar-toggle type="button" class="btn-toggle-sidebar me-3" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">
                <span aria-hidden="true">☰</span>
            </button>

            <div class="page-title flex-grow-1">
                <span class="page-title-text">{% block page_title %}{% endblock %}</span>
            </div>

            <!-- CONTROLOS PREMIUM -->
            <div class="d-flex align-items-center gap-2">

                <!-- Dark Mode -->
                <button id="btnDarkMode" type="button" class="btn btn-sm btn-outline-secondary" title="Modo Escuro" aria-label="Alternar modo escuro" aria-pressed="false">
                    <span aria-hidden="true">◐</span>
                </button>

                <!-- Temas -->
                <div class="btn-group theme-controls">
                    <button class="btn btn-sm btn-outline-primary" data-theme="theme-blue" title="Tema Azul">
                        <span aria-hidden="true">●</span>
                    </button>
                    <button class="btn btn-sm btn-outline-success" data-theme="theme-green" title="Tema Verde">
                        <span aria-hidden="true">●</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-theme="theme-gray" title="Tema Cinza">
                        <span aria-hidden="true">●</span>
                    </button>
                </div>

                <!-- User -->
                <div class="dropdown">
                    <a class="user-info d-flex align-items-center gap-2 dropdown-toggle"
                       href="#" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opções da conta: {{ auth.user.nome }}" style="cursor:pointer;">
                        <span class="user-name">{{ auth.user.nome }}</span>
                        <span class="avatar rounded-circle avatar-placeholder" aria-hidden="true">{{ (auth.user.nome|default('?'))|slice(0,1)|upper }}</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/perfil"><i class="bi bi-person"></i> Perfil</a></li>
                        <li><a class="dropdown-item" href="/admin/definicoes"><i class="bi bi-gear"></i> Definições</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Sair</a></li>
                    </ul>
                </div>

            </div>

        </header>

        <!-- CONTEÚDO -->
        <section id="conteudo_principal" class="page-content" tabindex="-1">
            {% include "@admin/flash.twig" %}
            {% block content %}{% endblock %}
        </section>

    </main>

</div>

<!-- OVERLAY -->
<button type="button" class="sidebar-overlay" aria-label="Fechar menu" tabindex="-1"></button>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- ADMIN JS PREMIUM -->
<script>
// O menu essencial funciona mesmo se os assets externos não forem publicados.
(() => {
    const button = document.getElementById('btnToggleSidebar');
    const overlay = document.querySelector('.sidebar-overlay');
    const mobile = window.matchMedia('(max-width: 992px)');
    function setOpen(open) {
        open = Boolean(open && mobile.matches);
        document.body.classList.toggle('sidebar-open', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    }
    button.addEventListener('click', () => setOpen(!document.body.classList.contains('sidebar-open')));
    overlay.addEventListener('click', () => setOpen(false));
    document.querySelectorAll('.sidebar-nav a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && document.body.classList.contains('sidebar-open')) {
            setOpen(false); button.focus();
        }
    });
    if (mobile.addEventListener) mobile.addEventListener('change', () => setOpen(false));
    else mobile.addListener(() => setOpen(false));
    setOpen(false);
})();
</script>
<script src="/assets/js/admin.js?v=20261108-menu-4"></script>

{% block scripts %}{% endblock %}
{% block modals %}{% endblock %}

</body>
</html>
